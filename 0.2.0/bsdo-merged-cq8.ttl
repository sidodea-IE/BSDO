bsdo:Sta_Volta_Cirebon bsdo:operatedBy bsdo:Op_Volta .
bsdo:Sta_Volta_Mitra   bsdo:operatedBy bsdo:Op_Volta .

bsdo:Plan_SWAP_100km      bsdo:operatedBy bsdo:Op_SWAP .
bsdo:Plan_SWAP_250km      bsdo:operatedBy bsdo:Op_SWAP .
bsdo:Plan_SWAP_500km      bsdo:operatedBy bsdo:Op_SWAP .
