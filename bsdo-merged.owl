    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n677f92213537418a9f8f4100991e68ffb32">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDisjointClasses"/>
    <owl:members rdf:nodeID="n677f92213537418a9f8f4100991e68ffb33"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#Offline">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bsdo#NetworkEnrolmentStatus"/>
    <rdfs:label xml:lang="en">offline</rdfs:label>
  </rdf:Description>
</rdf:RDF>
