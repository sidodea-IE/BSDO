    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bsdo#VoltageClass"/>
    <rdfs:label xml:lang="en">72 V</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n677f92213537418a9f8f4100991e68ffb38">
    <rdf:first rdf:resource="https://w3id.org/bsdo#Op_SWAP"/>
    <rdf:rest rdf:nodeID="n677f92213537418a9f8f4100991e68ffb39"/>
  </rdf:Description>
