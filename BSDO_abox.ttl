@prefix bsdo:  <https://w3id.org/bsdo#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

#################################################################
#  BSDO ABox v2 — populasi dua ekosistem empiris
#  Dibangun 26 Jul 2026. Impor TBox: BSDO_v2.ttl
#
#  ATURAN YANG DIPATUHI:
#  1. Hanya fakta TEROBSERVASI. Tidak ada nilai plausibel yang diisi.
#     (Pelajaran dari audit_draft_vs_owl.md — jangan ulangi.)
#  2. SELURUH pengenal dipseudonimkan: nama, nomor polisi, rangka, mesin,
#     nomor seri baterai, koordinat GPS. Pola skema penomoran dipertahankan
#     sebagai deskripsi karena perbedaannya adalah temuan.
#  3. Setiap individual menyebut sumbernya pada rdfs:comment.
#  4. Nilai yang berasal dari materi demo/pemasaran ditandai eksplisit.
#################################################################

<https://w3id.org/bsdo/abox> rdf:type owl:Ontology ;
    owl:imports <https://w3id.org/bsdo> ;
    dcterms:title "BSDO ABox — SWAP Energy & Volta"@en ;
    rdfs:comment "Populasi dua ekosistem battery swap Indonesia dari observasi aplikasi, situs resmi, dan dokumentasi pabrikan. Seluruh pengenal dipseudonimkan."@id .

#################################################################
#  1. OPERATOR
#################################################################

bsdo:Op_SWAP rdf:type owl:NamedIndividual , bsdo:Operator ;
    rdfs:label "SWAP Energy"@en ;
    skos:altLabel "Swap Energi Indonesia"@id .

bsdo:Op_Volta rdf:type owl:NamedIndividual , bsdo:Operator ;
    rdfs:label "Volta"@en ;
    skos:altLabel "PT Volta Indonesia Semesta"@id .

[] rdf:type owl:AllDifferent ; owl:distinctMembers ( bsdo:Op_SWAP bsdo:Op_Volta ) .

#################################################################
#  2. SKEMA PENGENAL — perbedaannya adalah temuan
#################################################################

bsdo:Scheme_SWAP rdf:type owl:NamedIndividual , bsdo:IdentifierScheme ;
    rdfs:label "SWAP unit identifier scheme"@en ;
    rdfs:comment "Pola terobservasi: prefiks dua huruf menurut jenis entitas (BB baterai, MC kendaraan, SS stasiun) diikuti deret digit. Tidak tampak mengikuti ISO/IEC 15459."@id .

bsdo:Scheme_Volta rdf:type owl:NamedIndividual , bsdo:IdentifierScheme ;
    rdfs:label "Volta unit identifier scheme"@en ;
    rdfs:comment "Pola terobservasi: prefiks BT + deret digit tetap + empat huruf + deret digit. Berbeda dari skema SWAP dan tidak saling ditafsirkan. Tidak tampak mengikuti ISO/IEC 15459."@id .

#################################################################
#  3. MODEL BATERAI — objek konteks K1
#################################################################

bsdo:BatMod_SWAP_64V rdf:type owl:NamedIndividual , bsdo:LithiumIonSwappableBattery ;
    rdfs:label "SWAP battery, 64 V class"@en ;
    bsdo:hasVoltageClass bsdo:VC_64V , bsdo:VC_60V ;
    bsdo:hasCellChemistry bsdo:LithiumIon ;
    bsdo:hasCapacityKWh "1.3"^^xsd:decimal ;
    bsdo:hasIdentifierScheme bsdo:Scheme_SWAP ;
    rdfs:comment "Situs resmi swap.id: Lithium-Ion, 140 x 177 x 330 mm, 1,3 kWh, IP67/CE/IEC 62133/UN 38.3. DUA kelas tegangan sengaja diasserikan: situs menyebut 64 V, aplikasi memberi label 60 V pada toggle dan lencana slot. Ketidakstabilan terminologi intra-ekosistem direkam apa adanya, tidak diselesaikan."@id .

bsdo:BatMod_SWAP_72V rdf:type owl:NamedIndividual , bsdo:LithiumIonSwappableBattery ;
    rdfs:label "SWAP battery, 72 V class"@en ;
    bsdo:hasVoltageClass bsdo:VC_72V ;
    bsdo:hasCellChemistry bsdo:LithiumIon ;
    bsdo:hasCapacityAh "30"^^xsd:decimal ;
    bsdo:hasCapacityKWh "2.1"^^xsd:decimal ;
    bsdo:hasIdentifierScheme bsdo:Scheme_SWAP ;
    rdfs:comment "Situs resmi swap.id (2,1 kWh) + smoot.id (72 V / 30 Ah, 12 kg, Lithium-Ion, IP67/CE/IEC 62133/UN 38.3)."@id .

bsdo:BatMod_Volta_401 rdf:type owl:NamedIndividual , bsdo:LFPSwappableBattery ;
    rdfs:label "Volta SGB battery, 60 V class"@en ;
    bsdo:hasVoltageClass bsdo:VC_60V ;
    bsdo:hasCellChemistry bsdo:LithiumIronPhosphate ;
    bsdo:hasCapacityAh "23"^^xsd:decimal ;
    bsdo:hasIdentifierScheme bsdo:Scheme_Volta ;
    rdfs:comment "Buku Panduan Pemakaian dan Garansi Volta, hlm. 2: '60v 23ah SGB lifepo4 battery (2 slot)'."@id .

bsdo:BatMod_Volta_Eagle rdf:type owl:NamedIndividual , bsdo:LFPSwappableBattery ;
    rdfs:label "Volta SGB battery, 64 V class"@en ;
    bsdo:hasVoltageClass bsdo:VC_64V ;
    bsdo:hasCellChemistry bsdo:LithiumIronPhosphate ;
    bsdo:hasCapacityAh "21"^^xsd:decimal ;
    bsdo:hasIdentifierScheme bsdo:Scheme_Volta ;
    rdfs:comment "Buku Panduan Pemilik Volta Eagle, hlm. 4: '64V 21 AH SGB LIFEPO4 BATTERY (2 SLOT)'. TEMUAN KUNCI: berbagi kelas tegangan 64 V dengan BatMod_SWAP_64V namun berbeda kimia sel; keduanya tetap tak dapat dipertukarkan. Konsep formal K1 {b1,b4}."@id .

#################################################################
#  4. UNIT BATERAI TERAMATI — pengenal dipseudonimkan
#################################################################

bsdo:Pack_S01 rdf:type owl:NamedIndividual , bsdo:SwappableBattery ;
    bsdo:hasUnitIdentifier "SWAP-PSEUDO-01" ;
    bsdo:hasIdentifierScheme bsdo:Scheme_SWAP ;
    bsdo:ownedBy bsdo:Op_SWAP ;
    rdfs:comment "Pengenal asli dipseudonimkan. Sumber: tab Battery aplikasi SWAP (materi demo/promosi, penanda waktu 2021) — STRUKTUR dipakai sebagai bukti, NILAI tidak diperlakukan sebagai pengukuran. Kepemilikan operator adalah inferensi dari model tarif per-km; lihat catatan ketidakpastian di fca_insidensi_v2.md f1-f3/p7."@id .

bsdo:Pack_V01 rdf:type owl:NamedIndividual , bsdo:SwappableBattery ;
    bsdo:hasUnitIdentifier "VOLTA-PSEUDO-01" ;
    bsdo:hasIdentifierScheme bsdo:Scheme_Volta ;
    bsdo:hasEnrolmentStatus bsdo:Online ;
    rdfs:comment "Pengenal asli dipseudonimkan. Sumber: aplikasi Volta, tab Baterai. Status Menyala, energi 92%."@id .

bsdo:Pack_V02 rdf:type owl:NamedIndividual , bsdo:SwappableBattery ;
    bsdo:hasUnitIdentifier "VOLTA-PSEUDO-02" ;
    bsdo:hasIdentifierScheme bsdo:Scheme_Volta ;
    bsdo:hasEnrolmentStatus bsdo:Online ;
    rdfs:comment "Pengenal asli dipseudonimkan. Sumber: aplikasi Volta. Status Mati, energi 99%."@id .

#  --- Pengamatan keadaan (BSOR D3, terbatas pada titik waktu) ---
bsdo:Obs_V01_a rdf:type owl:NamedIndividual , bsdo:BatteryStateObservation ;
    bsdo:observationOf bsdo:Pack_V01 ;
    bsdo:hasStateOfCharge "92"^^xsd:decimal ;
    rdfs:comment "Waktu pengamatan asli dipertahankan tanpa presisi lokasi. Volta memaparkan SoC per unit; TIDAK memaparkan indikator kesehatan."@id .

bsdo:Obs_S01_a rdf:type owl:NamedIndividual , bsdo:BatteryStateObservation ;
    bsdo:observationOf bsdo:Pack_S01 ;
    bsdo:hasStateOfCharge "99"^^xsd:decimal ;
    bsdo:hasQualitativeHealthLabel "Healthy" ;
    rdfs:comment "SWAP memaparkan lencana kualitatif 'Healthy' tanpa skala/ambang/metode yang diungkapkan, plus suhu 30 C. Nilai berasal dari materi demo. Lencana ini TIDAK memenuhi maksud Annex XIII 4(b) Regulasi (EU) 2023/1542 dan tidak dapat dipetakan lintas operator."@id .

#################################################################
#  5. PERANGKAT — objek konteks K2
#################################################################

bsdo:Dev_SWAP_Small rdf:type owl:NamedIndividual , bsdo:SwapDevice , bsdo:LithiumIonOnlyDevice ;
    rdfs:label "SWAP Small station"@en ;
    skos:altLabel "3-Slot Station"@id ;
    bsdo:acceptsChemistry bsdo:LithiumIon ;
    rdfs:comment "Situs resmi: 1500 W, 839 x 305 x 411 mm, kapasitas 2 baterai, IP54/CE/IEC 62840. Aplikasi menyebutnya '3-Slot Station' — kapasitas terpublikasi (2) berbeda satu dari jumlah slot (3); slot ke-n diduga menerima pak kosong pengguna. Indikator warna pada tipe ini menandakan TINGKAT SoC (merah 0-40, biru 41-80, hijau 81-100)."@id .

bsdo:Dev_SWAP_Big rdf:type owl:NamedIndividual , bsdo:SwapDevice , bsdo:LithiumIonOnlyDevice ;
    rdfs:label "SWAP Big station"@en ;
    skos:altLabel "8-Slot Station"@id ;
    bsdo:acceptsChemistry bsdo:LithiumIon ;
    rdfs:comment "Situs resmi: 11.000 W, 1800 x 790 x 644 mm, kapasitas 7 baterai. Indikator warna pada tipe ini menandakan STATE PROSES AUTENTIKASI (merah tidak terbaca, kuning sedang membaca, hijau berhasil terbaca) — berbeda arti dari tipe Small meskipun himpunan warnanya sama. Konflik homonim intra-ekosistem."@id .

bsdo:Dev_SWAP_Home rdf:type owl:NamedIndividual , bsdo:ChargingDevice ;
    rdfs:label "Swap Home charger"@en ;
    rdfs:comment "Situs resmi: 200 W, 272 x 210 x 59 mm, 1 baterai, durasi pengisian 8 jam (0-100%). Perangkat PENGISIAN, bukan penukaran — instansi langsung pembedaan transfer energi vs transfer objek (BSOR D5)."@id .

bsdo:Dev_Volta_Cabinet rdf:type owl:NamedIndividual , bsdo:SwapDevice , bsdo:ChargingDevice , bsdo:LFPOnlyDevice ;
    rdfs:label "Volta SGB cabinet"@en ;
    skos:altLabel "kabinet SGB"@id ;
    bsdo:acceptsChemistry bsdo:LithiumIronPhosphate ;
    rdfs:comment "Terobservasi 8 pintu dengan status dan SoC per pintu (Showroom Volta Cirebon). Melayani penukaran DAN pengisian (SCB) pada perangkat yang sama — karena itu diklasifikasikan sebagai SwapDevice sekaligus ChargingDevice. Reasoner seharusnya menginferensinya sebagai DualFunctionDevice. Kontras dengan SWAP Energy yang memisahkan kedua fungsi ke perangkat berbeda."@id .

#  --- Instansi stasiun terobservasi (tuan rumah dipertahankan; tidak ada data pribadi) ---
bsdo:Sta_SWAP_Sleman rdf:type owl:NamedIndividual , bsdo:SwapDevice ;
    rdfs:label "SWAP station, Sleman"@en ;
    rdfs:comment "Pengenal stasiun asli berpola SS + digit, dipseudonimkan. Delapan slot terobservasi dengan SoC per slot dan label kelas tegangan per slot. Jam operasi 00:00-23:59."@id .

bsdo:Sta_Volta_Cirebon rdf:type owl:NamedIndividual , bsdo:SwapDevice , bsdo:ChargingDevice ;
    rdfs:label "Volta SGB, Cirebon showroom"@en ;
    rdfs:comment "Delapan pintu; dua terisi (86%, 96%), sisanya Kosong atau Tidak Tersedia. Jam operasi 00:00-23:59 setiap hari. Tuan rumah: showroom merek."@id .

bsdo:Sta_Volta_Mitra rdf:type owl:NamedIndividual , bsdo:SwapDevice ;
    rdfs:label "Volta SGB Mitra, SPBU"@en ;
    rdfs:comment "Tuan rumah SPBU. Menampilkan ketersediaan sebagai bucket agregat (50% ke bawah, 80% ke atas, booking, charging), BUKAN per pintu. Perbedaan tampilan dari Sta_Volta_Cirebon belum terjelaskan — jangan disimpulkan sebagai tipe perangkat berbeda."@id .

#################################################################
#  6. ATURAN KELAYAKAN TUKAR — ekstensi predikat yang BERBEDA (CQ5b)
#################################################################

bsdo:Elig_SWAP rdf:type owl:NamedIndividual , bsdo:SwapEligibilityRule ;
    bsdo:thresholdPercent "50"^^xsd:decimal ;
    bsdo:declaredBy bsdo:Op_SWAP ;
    rdfs:label "SWAP swap-eligibility threshold"@en ;
    rdfs:comment "Aplikasi menyatakan 'Baterai Dapat Ditukar (SOC >= 50%)'. Ambang TUNGGAL; stok dilaporkan sebagai tiga penghitung (Bisa Ditukar, Bisa Dipesan, Semua)."@id .

bsdo:Elig_Volta_Low rdf:type owl:NamedIndividual , bsdo:SwapEligibilityRule ;
    bsdo:thresholdPercent "50"^^xsd:decimal ;
    bsdo:declaredBy bsdo:Op_Volta ;
    rdfs:label "Volta bucket, below 50%"@en .

bsdo:Elig_Volta_High rdf:type owl:NamedIndividual , bsdo:SwapEligibilityRule ;
    bsdo:thresholdPercent "80"^^xsd:decimal ;
    bsdo:declaredBy bsdo:Op_Volta ;
    rdfs:label "Volta bucket, 80% and above"@en ;
    rdfs:comment "Volta melaporkan DUA bucket yang tidak mempartisi interval yang sama. Pak pada 65% terklasifikasi oleh Elig_SWAP tetapi tidak masuk bucket Volta mana pun. Ketidaksepadanan ekstensi predikat — jawaban CQ5b."@id .

#################################################################
#  7. PAKET TARIF — dua dimensi kuota yang tidak sepadan (CQ5)
#################################################################

bsdo:Plan_SWAP_100km rdf:type owl:NamedIndividual , bsdo:DistanceQuotaPlan ;
    rdfs:label "Try to Ride"@en ;
    bsdo:quotaAmount "100"^^xsd:decimal ; bsdo:validityDays "30"^^xsd:integer ;
    rdfs:comment "Rp 20.000. Kuota dalam KILOMETER."@id .
bsdo:Plan_SWAP_250km rdf:type owl:NamedIndividual , bsdo:DistanceQuotaPlan ;
    rdfs:label "Good Good Ride"@en ;
    bsdo:quotaAmount "250"^^xsd:decimal ; bsdo:validityDays "60"^^xsd:integer ;
    rdfs:comment "Rp 45.000. Situs menyebut 45 hari, aplikasi 60 hari — versi berbeda, keduanya dicatat."@id .
bsdo:Plan_SWAP_500km rdf:type owl:NamedIndividual , bsdo:DistanceQuotaPlan ;
    rdfs:label "Happly Ride"@en ;
    bsdo:quotaAmount "500"^^xsd:decimal ; bsdo:validityDays "60"^^xsd:integer ;
    rdfs:comment "Rp 80.000. Ejaan 'Happly' sesuai aplikasi."@id .

bsdo:Plan_Volta_Harian rdf:type owl:NamedIndividual , bsdo:EventCountQuotaPlan ;
    rdfs:label "Paket Harian"@id ;
    bsdo:quotaAmount "1"^^xsd:decimal ; bsdo:validityDays "1"^^xsd:integer ;
    rdfs:comment "Rp 7.500. Kuota dalam JUMLAH PENUKARAN."@id .
bsdo:Plan_Volta_Mingguan rdf:type owl:NamedIndividual , bsdo:EventCountQuotaPlan ;
    rdfs:label "Paket Mingguan"@id ;
    bsdo:quotaAmount "14"^^xsd:decimal ; bsdo:validityDays "7"^^xsd:integer ;
    rdfs:comment "Rp 100.000. Penukaran ke-15 kembali ke harga harian."@id .
bsdo:Plan_Volta_Bulanan rdf:type owl:NamedIndividual , bsdo:EventCountQuotaPlan ;
    rdfs:label "Paket Bulanan"@id ;
    bsdo:quotaAmount "50"^^xsd:decimal ; bsdo:validityDays "30"^^xsd:integer ;
    rdfs:comment "Rp 350.000. Penukaran ke-51 kembali ke harga harian. Paket terikat pada satu unit kendaraan terdaftar."@id .

#################################################################
#  8. SPESIFIKASI ALUR LAYANAN — objek konteks K3
#  CATATAN: ini spesifikasi PROSEDUR dari dokumentasi resmi, BUKAN transaksi
#  yang tercatat. Payload transaksi tidak dapat diobservasi (peneliti tidak
#  memiliki riwayat transaksi). Dinyatakan di Limitations.
#################################################################

bsdo:Flow_SWAP_Swap3 rdf:type owl:NamedIndividual , bsdo:SwapEvent ;
    rdfs:label "SWAP direct swap, 3-slot"@en ;
    bsdo:occursAtDevice bsdo:Dev_SWAP_Small ;
    rdfs:comment "Panduan in-app 'Cara Swap Baterai', tab 3-Slot Station. Langkah 1: angkat baterai dari bagasi motor."@id .

bsdo:Flow_SWAP_Swap8 rdf:type owl:NamedIndividual , bsdo:SwapEvent ;
    rdfs:label "SWAP direct swap, 8-slot"@en ;
    bsdo:occursAtDevice bsdo:Dev_SWAP_Big ;
    rdfs:comment "Panduan in-app, tab 8-Slot Station. Langkah 1: letakkan baterai ke pijakan baterai — pembaca terpisah sebelum slot."@id .

bsdo:Flow_SWAP_Booking rdf:type owl:NamedIndividual , bsdo:SwapEvent ;
    rdfs:label "SWAP booking"@en ;
    rdfs:comment "Dialog 'Confirm Battery Booking'. Batas waktu, kewajiban pindai, dan pembukaan pintu otomatis TIDAK terdokumentasi — ditandai unarticulated di fca_insidensi_v2.md."@id .

bsdo:Flow_Volta_Ganti rdf:type owl:NamedIndividual , bsdo:SwapEvent ;
    rdfs:label "Ganti Baterai"@id ;
    bsdo:occursAtDevice bsdo:Dev_Volta_Cabinet ;
    rdfs:comment "Manual Volta Membership hlm. 9: pilih kabinet, pindai, pintu kosong terbuka, tukar. Tidak menyebut pembayaran maupun batas waktu — kontras dengan Booking dan Tukar Titip yang menyebutnya eksplisit."@id .

bsdo:Flow_Volta_Booking rdf:type owl:NamedIndividual , bsdo:SwapEvent ;
    rdfs:label "Booking Baterai"@id ;
    bsdo:occursAtDevice bsdo:Dev_Volta_Cabinet ;
    bsdo:hasParticipantCustomer bsdo:Cust_V01 ;
    rdfs:comment "Manual hlm. 7: pilih kabinet, bayar, 15 menit untuk memindai, pintu terbuka."@id .

bsdo:Flow_Volta_TukarTitip rdf:type owl:NamedIndividual , bsdo:LoanEvent ;
    rdfs:label "Tukar Titip"@id ;
    bsdo:occursAtDevice bsdo:Dev_Volta_Cabinet ;
    bsdo:hasCustodyDeadlineHours "6"^^xsd:decimal ;
    bsdo:returnsPackTo bsdo:Cust_V01 ;
    rdfs:comment "Manual hlm. 8: bayar, 15 menit untuk memindai, ambil BATERAI PINJAMAN, tukar kembali dengan baterai miliknya sebelum 6 jam. Pengguna memegang pak operator; kepemilikan pengguna atas paknya sendiri tidak berpindah. Konsep formal K3 {f6,f7}."@id .

bsdo:Flow_Volta_SCB rdf:type owl:NamedIndividual , bsdo:DepositChargingEvent ;
    rdfs:label "SCB"@id ;
    bsdo:occursAtDevice bsdo:Dev_Volta_Cabinet ;
    bsdo:hasCustodyDeadlineHours "6"^^xsd:decimal ;
    bsdo:returnsPackTo bsdo:Cust_V01 ;
    rdfs:comment "Manual hlm. 6: aktifkan SCB, 15 menit untuk memindai, mulai pengisian, ambil kembali baterai miliknya sebelum 6 jam. Arah kustodi BERLAWANAN dari Tukar Titip: operator memegang pak pengguna. Keduanya seharusnya diinferensi sebagai CustodyPreservingEvent."@id .

#################################################################
#  9. AKTOR & KENDARAAN
#################################################################

bsdo:Cust_V01 rdf:type owl:NamedIndividual , bsdo:Customer ;
    rdfs:label "Customer V01 (pseudonymised)"@en ;
    rdfs:comment "Data pribadi pihak ketiga dipseudonimkan sepenuhnya: nama, foto, nomor polisi, rangka, mesin, koordinat GPS tidak direkam."@id .

bsdo:Veh_Volta401 rdf:type owl:NamedIndividual , bsdo:ElectricMotorcycle ;
    rdfs:label "Volta 401"@en ;
    rdfs:comment "Buku panduan: 1500 W, 60 km, 200 kg, 2 slot baterai. Pengenal kendaraan dipseudonimkan."@id .

bsdo:Veh_VoltaEagle rdf:type owl:NamedIndividual , bsdo:ElectricMotorcycle ;
    rdfs:label "Volta Eagle"@en ;
    rdfs:comment "Buku panduan: 1500 W, 60 km, 150 kg, 2 slot, double disc brake, keyless + NFC."@id .

bsdo:Veh_DeSultan rdf:type owl:NamedIndividual , bsdo:ElectricMotorcycle ;
    rdfs:label "Smoot De Sultan"@en ;
    rdfs:comment "smoot.id: 72 V / 30 Ah, DC brushless 2500 W, 99 kg, beban maks 150 kg, CBS."@id .

#  --- Relasi baterai-kendaraan TEMPORER (BSOR D2) ---
bsdo:Inst_V01 rdf:type owl:NamedIndividual , bsdo:BatteryInstallation ;
    bsdo:installedPack bsdo:Pack_V01 ;
    bsdo:installedIn bsdo:Veh_Volta401 ;
    rdfs:comment "Pemasangan direifikasi, bukan part-of mereologis: pak berpindah antar kendaraan melalui penukaran, sehingga relasi tetap akan salah."@id .

#################################################################
# 10. KEPEMILIKAN vs PENGUASAAN — bukti dokumenter (BSOR D4)
#################################################################

bsdo:Pack_V01 bsdo:ownedBy bsdo:Cust_V01 ;
              bsdo:heldBy bsdo:Cust_V01 ;
              bsdo:mayBeChargedByHolder "false"^^xsd:boolean .

#  Buku Panduan Volta 401 hlm. 5: "Tidak di perbolehkan untuk melakukan pengecasan sendiri."
#  Pengguna MEMILIKI pak dan MEMEGANGNYA, tetapi TIDAK berwenang mengisinya.
#  Kepemilikan dan hak mengelola terpisah — terdokumentasi, bukan inferensi.
#  Buku Panduan Volta Eagle justru memuat petunjuk pengisian langsung; pembedanya
#  adalah status pendaftaran jaringan (online/offline), bukan kepemilikan.

#################################################################
# 11. KEANGGOTAAN EKOSISTEM — diperlukan untuk CQ4 & CQ5
#     Setiap artefak terobservasi pada ekosistem tertentu.
#################################################################

bsdo:BatMod_SWAP_64V   bsdo:operatedBy bsdo:Op_SWAP .
bsdo:BatMod_SWAP_72V   bsdo:operatedBy bsdo:Op_SWAP .
bsdo:BatMod_Volta_401  bsdo:operatedBy bsdo:Op_Volta .
bsdo:BatMod_Volta_Eagle bsdo:operatedBy bsdo:Op_Volta .

bsdo:Dev_SWAP_Small    bsdo:operatedBy bsdo:Op_SWAP .
bsdo:Dev_SWAP_Big      bsdo:operatedBy bsdo:Op_SWAP .
bsdo:Dev_SWAP_Home     bsdo:operatedBy bsdo:Op_SWAP .
bsdo:Dev_Volta_Cabinet bsdo:operatedBy bsdo:Op_Volta .
bsdo:Sta_SWAP_Sleman   bsdo:operatedBy bsdo:Op_SWAP .
bsdo:Sta_Volta_Cirebon bsdo:operatedBy bsdo:Op_Volta .
bsdo:Sta_Volta_Mitra   bsdo:operatedBy bsdo:Op_Volta .

bsdo:Plan_SWAP_100km      bsdo:operatedBy bsdo:Op_SWAP .
bsdo:Plan_SWAP_250km      bsdo:operatedBy bsdo:Op_SWAP .
bsdo:Plan_SWAP_500km      bsdo:operatedBy bsdo:Op_SWAP .
bsdo:Plan_Volta_Harian    bsdo:operatedBy bsdo:Op_Volta .
bsdo:Plan_Volta_Mingguan  bsdo:operatedBy bsdo:Op_Volta .
bsdo:Plan_Volta_Bulanan   bsdo:operatedBy bsdo:Op_Volta .

bsdo:Flow_SWAP_Swap3      bsdo:operatedBy bsdo:Op_SWAP .
bsdo:Flow_SWAP_Swap8      bsdo:operatedBy bsdo:Op_SWAP .
bsdo:Flow_SWAP_Booking    bsdo:operatedBy bsdo:Op_SWAP .
bsdo:Flow_Volta_Ganti     bsdo:operatedBy bsdo:Op_Volta .
bsdo:Flow_Volta_Booking   bsdo:operatedBy bsdo:Op_Volta .
bsdo:Flow_Volta_TukarTitip bsdo:operatedBy bsdo:Op_Volta .
bsdo:Flow_Volta_SCB       bsdo:operatedBy bsdo:Op_Volta .

bsdo:Veh_Volta401     bsdo:operatedBy bsdo:Op_Volta .
bsdo:Veh_VoltaEagle   bsdo:operatedBy bsdo:Op_Volta .
bsdo:Veh_DeSultan     bsdo:operatedBy bsdo:Op_SWAP .
