<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:dcterms="http://purl.org/dc/terms/"
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
>
  <rdf:Description rdf:about="https://w3id.org/bsdo#operatedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="https://w3id.org/bsdo#Operator"/>
    <rdfs:label xml:lang="en">operated by</rdfs:label>
    <rdfs:comment xml:lang="id">Menautkan artefak apa pun (perangkat, paket tarif, aturan kelayakan, model baterai) ke operator ekosistemnya. Sengaja TANPA rdfs:domain agar dapat dipakai lintas famili artefak — keanggotaan ekosistem terobservasi langsung untuk setiap artefak dalam studi ini. Diperlukan agar CQ4 dan CQ5 dapat dijawab.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/bsdo#EcosystemArtefact"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#DistanceQuotaPlan">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bsdo#QuotaPlan"/>
    <rdfs:label xml:lang="en">Distance Quota Plan</rdfs:label>
    <rdfs:comment xml:lang="id">Kuota dalam kilometer (SWAP Energy: 100/250/500 km dengan masa berlaku 30/60 hari).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#CellChemistry">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Cell Chemistry</rdfs:label>
    <rdfs:comment xml:lang="id">Kimia sel sebagai nilai terenumerasi. LiFePO4 dan Lithium-Ion generik dinyatakan berbeda.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#installedPack">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/bsdo#BatteryInstallation"/>
    <rdfs:range rdf:resource="https://w3id.org/bsdo#SwappableBattery"/>
    <rdfs:label xml:lang="en">installed pack</rdfs:label>
    <rdfs:comment xml:lang="id">Pak yang terpasang pada kendaraan dalam episode pemasangan ini.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#heldBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/bsdo#SwappableBattery"/>
    <rdfs:range rdf:resource="https://w3id.org/bsdo#Agent"/>
    <rdfs:label xml:lang="en">held by</rdfs:label>
    <rdfs:comment xml:lang="id">Penguasaan fisik saat ini. Fungsional: satu pak dipegang paling banyak satu pihak. Dapat berbeda dari ownedBy — inilah pembedaan yang tidak dimiliki ontologi pembanding mana pun.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#DepositChargingEvent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bsdo#EnergyTransferEvent"/>
    <rdfs:label xml:lang="en">Deposit Charging Event</rdfs:label>
    <skos:altLabel xml:lang="id">SCB</skos:altLabel>
    <skos:altLabel xml:lang="id">Sistem Charge Battery</skos:altLabel>
    <rdfs:comment xml:lang="id">Pak milik pengguna dititipkan ke kabinet untuk diisi, lalu diambil kembali.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#BatteryInstallation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Battery Installation</rdfs:label>
    <rdfs:comment xml:lang="id">Reifikasi pemasangan pak pada kendaraan. Relasi ini SENGAJA tidak dimodelkan sebagai part-of mereologis: dalam swapping pak berpindah antar kendaraan, sehingga relasi tetap akan salah. Bandingkan EVO (Kivrakidis et al. 2024) yang memiliki pola reifikasi serupa (BatteryRelation) tetapi pada tingkat TIPE dan tanpa dimensi waktu.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#SwappableBattery">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/battery#battery_74ed2670_657d_4f0b_b0a6_3f13bc2e9c17"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bsdo#EcosystemArtefact"/>
    <rdfs:label xml:lang="en">Swappable Battery</rdfs:label>
    <rdfs:label xml:lang="id">Baterai Tukar</rdfs:label>
    <rdfs:comment xml:lang="id">Selaras ke EMMO domain-battery:Battery (lapisan kosakata yang diprofilkan BattINFO, bukan BattINFO itu sendiri).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#hasQualitativeHealthLabel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/bsdo#BatteryStateObservation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:seeAlso rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_a7a4614f_2426_46f3_8475_cda4a9fabfce"/>
    <rdfs:comment xml:lang="id">SENGAJA bertipe string, bukan desimal. Satu ekosistem memaparkan lencana kualitatif ('Healthy') tanpa skala, ambang, atau metode penurunan yang diungkapkan; satu lagi tidak memaparkan apa pun. Ini BUKAN state of health terkuantifikasi sebagaimana dituntut Annex XIII §4(b) Regulasi (EU) 2023/1542, dan tidak dapat dipetakan lintas operator.</rdfs:comment>
    <rdfs:label xml:lang="en">qualitative health label</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#LithiumIonOnlyDevice">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bsdo#BatteryHandlingDevice"/>
    <rdfs:subClassOf rdf:nodeID="ndb82936423794b4b9d8aeb59d29bdab6b35"/>
    <rdfs:label xml:lang="en">Lithium-Ion-Only Device</rdfs:label>
    <rdfs:comment xml:lang="id">Perangkat yang hanya menerima pak berkimia Lithium-Ion. Batasan allValuesFrom di sini yang membuat inkompatibilitas terdeteksi sebagai inkonsistensi.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#accepts">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/bsdo#BatteryHandlingDevice"/>
    <rdfs:range rdf:resource="https://w3id.org/bsdo#SwappableBattery"/>
    <rdfs:comment xml:lang="id">Pak yang benar-benar dapat dilayani perangkat. TIDAK di-assert manual; dibatasi oleh aksioma kimia di bawah sehingga ketidakcocokan terdeteksi sebagai inkonsistensi, bukan sebagai hasil kueri kosong.</rdfs:comment>
    <rdfs:label xml:lang="en">accepts</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ndb82936423794b4b9d8aeb59d29bdab6b28">
    <rdf:first rdf:resource="https://w3id.org/bsdo#Online"/>
    <rdf:rest rdf:nodeID="ndb82936423794b4b9d8aeb59d29bdab6b29"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#NetworkEnrolledBattery">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:equivalentClass rdf:nodeID="ndb82936423794b4b9d8aeb59d29bdab6b30"/>
    <rdfs:subClassOf rdf:nodeID="ndb82936423794b4b9d8aeb59d29bdab6b31"/>
    <rdfs:label xml:lang="en">Network-Enrolled Battery</rdfs:label>
    <rdfs:comment xml:lang="id">Pak terdaftar SGB: kepemilikan tetap pada pengguna, hak mengisi daya berada pada operator. Inilah pemisahan kepemilikan dari hak mengelola, terdokumentasi pada manual resmi operator.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ndb82936423794b4b9d8aeb59d29bdab6b13">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDifferent"/>
    <owl:distinctMembers rdf:nodeID="ndb82936423794b4b9d8aeb59d29bdab6b14"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ndb82936423794b4b9d8aeb59d29bdab6b33">
    <rdf:first rdf:resource="https://w3id.org/bsdo#DistanceQuotaPlan"/>
    <rdf:rest rdf:nodeID="ndb82936423794b4b9d8aeb59d29bdab6b34"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#LFPOnlyDevice">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bsdo#BatteryHandlingDevice"/>
    <rdfs:subClassOf rdf:nodeID="ndb82936423794b4b9d8aeb59d29bdab6b36"/>
    <rdfs:label xml:lang="en">LiFePO4-Only Device</rdfs:label>
    <rdfs:comment xml:lang="id">Perangkat yang hanya menerima pak berkimia LiFePO4.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#acceptsChemistry">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/bsdo#BatteryHandlingDevice"/>
    <rdfs:range rdf:resource="https://w3id.org/bsdo#CellChemistry"/>
    <rdfs:label xml:lang="en">accepts chemistry</rdfs:label>
    <rdfs:comment xml:lang="id">Kimia sel yang dapat dilayani perangkat. Dasar deteksi inkompatibilitas sebagai inkonsistensi (CQ8).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#declaredBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/bsdo#SwapEligibilityRule"/>
    <rdfs:range rdf:resource="https://w3id.org/bsdo#Operator"/>
    <rdfs:label xml:lang="en">declared by</rdfs:label>
    <rdfs:comment xml:lang="id">Operator yang mendeklarasikan aturan ini. Aturan kelayakan bersifat khas-operator, bukan standar bersama.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#hasEnrolmentStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/bsdo#SwappableBattery"/>
    <rdfs:range rdf:resource="https://w3id.org/bsdo#NetworkEnrolmentStatus"/>
    <rdfs:label xml:lang="en">has enrolment status</rdfs:label>
    <rdfs:comment xml:lang="id">Status pendaftaran pak pada jaringan operator. Menentukan hak mengelola, BUKAN kepemilikan.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#Online">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bsdo#NetworkEnrolmentStatus"/>
    <rdfs:label xml:lang="en">online</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#hasUnitIdentifier">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/bsdo#SwappableBattery"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">unit identifier</rdfs:label>
    <rdfs:comment xml:lang="id">Pengenal unit persisten, lepas dari kendaraan mana pun. Terobservasi di KEDUA ekosistem. Skema penomoran berbeda dan tidak saling ditafsirkan; tidak ada yang tampak mengikuti ISO/IEC 15459 sebagaimana diwajibkan Regulasi (EU) 2023/1542 Art. 77(3).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ndb82936423794b4b9d8aeb59d29bdab6b5">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/bsdo#hasCustodyDeadlineHours"/>
    <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#ElectricMotorcycle">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Electric Motorcycle</rdfs:label>
    <rdfs:label xml:lang="id">Motor Listrik</rdfs:label>
    <rdfs:comment xml:lang="id">Kendaraan roda dua listrik berbaterai tukar. Relasi ke pak bersifat temporer — lihat BatteryInstallation.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bsdo#EcosystemArtefact"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#LoanEvent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bsdo#ObjectTransferEvent"/>
    <rdfs:label xml:lang="en">Loan Event</rdfs:label>
    <skos:altLabel xml:lang="id">Tukar Titip</skos:altLabel>
    <rdfs:comment xml:lang="id">Pertukaran objek dengan pak pinjaman; pak milik pengguna dikembalikan dalam batas waktu.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#SwapEvent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bsdo#ObjectTransferEvent"/>
    <rdfs:label xml:lang="en">Swap Event</rdfs:label>
    <rdfs:label xml:lang="id">Peristiwa Tukar</rdfs:label>
    <rdfs:comment xml:lang="id">Pertukaran objek yang pak keluarannya TIDAK kembali kepada pengguna.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#hasParticipantCustomer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/bsdo#ServiceEvent"/>
    <rdfs:range rdf:resource="https://w3id.org/bsdo#Customer"/>
    <rdfs:label xml:lang="en">has participant customer</rdfs:label>
    <rdfs:comment xml:lang="id">Pelanggan yang terlibat dalam peristiwa layanan.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#ChargingDevice">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bsdo#BatteryHandlingDevice"/>
    <rdfs:label xml:lang="en">Charging Device</rdfs:label>
    <rdfs:comment xml:lang="id">Konsep kokoh K2 {s3,s4}, intensi {charge}.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#VC_64V">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bsdo#VoltageClass"/>
    <rdfs:label xml:lang="en">64 V</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#hasCapacityKWh">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/bsdo#SwappableBattery"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="en">capacity (kWh)</rdfs:label>
    <rdfs:comment xml:lang="id">Kapasitas dalam kilowatt-jam. Lihat catatan pada hasCapacityAh.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#returnsPackTo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/bsdo#ServiceEvent"/>
    <rdfs:range rdf:resource="https://w3id.org/bsdo#Agent"/>
    <rdfs:label xml:lang="en">returns pack to</rdfs:label>
    <rdfs:comment xml:lang="id">Pihak yang menerima kembali pak pada akhir peristiwa. Hanya terisi pada peristiwa yang mempertahankan kepemilikan.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#thresholdPercent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/bsdo#SwapEligibilityRule"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="en">threshold (%)</rdfs:label>
    <rdfs:comment xml:lang="id">Ambang SoC yang dideklarasikan aturan. Nilai yang sama dapat menandakan hal berbeda: ambang tunggal pada satu ekosistem, batas bucket pada ekosistem lain (CQ5b).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ndb82936423794b4b9d8aeb59d29bdab6b31">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/bsdo#mayBeChargedByHolder"/>
    <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</owl:hasValue>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#NetworkEnrolmentStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Network Enrolment Status</rdfs:label>
    <rdfs:comment xml:lang="id">Status pendaftaran pak pada jaringan: online (terdaftar) atau offline.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#hasVoltageClass">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/bsdo#SwappableBattery"/>
    <rdfs:range rdf:resource="https://w3id.org/bsdo#VoltageClass"/>
    <rdfs:comment xml:lang="id">CATATAN: satu artefak dapat memiliki lebih dari satu deklarasi kelas tegangan. Baterai SWAP dideklarasikan 64 V oleh situs resmi dan 60 V oleh aplikasi. Properti ini SENGAJA tidak fungsional agar ketidakstabilan terminologi dapat direkam apa adanya.</rdfs:comment>
    <rdfs:comment xml:lang="id">Kelas tegangan nominal yang DIDEKLARASIKAN. Tidak fungsional: satu artefak dapat memiliki lebih dari satu deklarasi dari sumber berbeda.</rdfs:comment>
    <rdfs:label xml:lang="en">has voltage class</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ndb82936423794b4b9d8aeb59d29bdab6b6">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/bsdo#returnsPackTo"/>
    <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ndb82936423794b4b9d8aeb59d29bdab6b25">
    <rdf:first rdf:resource="https://w3id.org/bsdo#LithiumIonSwappableBattery"/>
    <rdf:rest rdf:nodeID="ndb82936423794b4b9d8aeb59d29bdab6b26"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#ObjectTransferEvent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bsdo#ServiceEvent"/>
    <rdfs:label xml:lang="en">Object Transfer Event</rdfs:label>
    <rdfs:comment xml:lang="id">Konsep kokoh K3 {f1..f6}, intensi {tukarObjek}. Enam alur dari KEDUA ekosistem; pembelahan ini lintas-operator, bukan artefak satu operator.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#LFPSwappableBattery">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:equivalentClass rdf:nodeID="ndb82936423794b4b9d8aeb59d29bdab6b20"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bsdo#SwappableBattery"/>
    <rdfs:label xml:lang="en">LiFePO4 Swappable Battery</rdfs:label>
    <rdfs:comment xml:lang="id">Pak tukar berkimia LiFePO4. Disjoint dengan LithiumIonSwappableBattery.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#Agent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Agent</rdfs:label>
    <rdfs:comment xml:lang="id">Pihak yang dapat memiliki atau memegang pak baterai.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ndb82936423794b4b9d8aeb59d29bdab6b17">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/bsdo#hasCellChemistry"/>
    <owl:hasValue rdf:resource="https://w3id.org/bsdo#LithiumIon"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#eventTime">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/bsdo#ServiceEvent"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:label xml:lang="en">event time</rdfs:label>
    <rdfs:comment xml:lang="id">Waktu terjadinya peristiwa. Umumnya kosong: payload transaksi tidak dapat diobservasi dari sumber yang tersedia (lihat CQ3).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#packRemoved">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/bsdo#ObjectTransferEvent"/>
    <rdfs:range rdf:resource="https://w3id.org/bsdo#SwappableBattery"/>
    <rdfs:label xml:lang="en">pack removed from vehicle</rdfs:label>
    <rdfs:comment xml:lang="id">Pak yang dikeluarkan dari kendaraan pada peristiwa transfer objek.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ndb82936423794b4b9d8aeb59d29bdab6b34">
    <rdf:first rdf:resource="https://w3id.org/bsdo#EventCountQuotaPlan"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ndb82936423794b4b9d8aeb59d29bdab6b2">
    <rdf:first rdf:resource="https://w3id.org/bsdo#ObjectTransferEvent"/>
    <rdf:rest rdf:nodeID="ndb82936423794b4b9d8aeb59d29bdab6b3"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ndb82936423794b4b9d8aeb59d29bdab6b14">
    <rdf:first rdf:resource="https://w3id.org/bsdo#LithiumIon"/>
    <rdf:rest rdf:nodeID="ndb82936423794b4b9d8aeb59d29bdab6b15"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#CustodyPreservingEvent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:equivalentClass rdf:nodeID="ndb82936423794b4b9d8aeb59d29bdab6b4"/>
    <rdfs:label xml:lang="en">Custody-Preserving Event</rdfs:label>
    <rdfs:comment xml:lang="id">Konsep kokoh K3 {f6,f7}. Peristiwa di mana PENGUASAAN berpindah sementara sedangkan KEPEMILIKAN tidak. Arah kustodi berlawanan pada kedua anggotanya: pada LoanEvent pengguna memegang pak operator; pada DepositChargingEvent operator memegang pak pengguna. Tidak satu pun ontologi pembanding (lihat telaah_BSOR_tabel_bukti.md) memiliki konstruk ini. BSOR D4.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#hasIdentifierScheme">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/bsdo#SwappableBattery"/>
    <rdfs:range rdf:resource="https://w3id.org/bsdo#IdentifierScheme"/>
    <rdfs:label xml:lang="en">has identifier scheme</rdfs:label>
    <rdfs:comment xml:lang="id">Skema penomoran pengenal unit. Kedua ekosistem memakai skema berbeda yang tidak saling ditafsirkan — titik pemetaan pertama untuk roaming (CQ7).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#hasCellChemistry">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/bsdo#SwappableBattery"/>
    <rdfs:range rdf:resource="https://w3id.org/bsdo#CellChemistry"/>
    <rdfs:label xml:lang="en">has cell chemistry</rdfs:label>
    <rdfs:comment xml:lang="id">Kimia sel yang dinyatakan produsen. Pembeda ekosistem yang sesungguhnya — lihat CQ4b.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#hasStateOfCharge">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/bsdo#BatteryStateObservation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:seeAlso rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_8b2aaa50_bbe1_45da_8778_8898326246a2"/>
    <rdfs:comment xml:lang="id">Selaras ke StateOfCharge di domain-electrochemistry. CATATAN: kelas StateOfCharge di namespace domain/battery berstatus owl:deprecated — jangan dipakai.</rdfs:comment>
    <rdfs:label xml:lang="en">state of charge (%)</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#IdentifierScheme">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Identifier Scheme</rdfs:label>
    <rdfs:comment xml:lang="id">Skema penomoran pengenal unit, khas per ekosistem.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#SwapDevice">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bsdo#BatteryHandlingDevice"/>
    <rdfs:label xml:lang="en">Swap Device</rdfs:label>
    <skos:altLabel xml:lang="id">BSS</skos:altLabel>
    <skos:altLabel xml:lang="id">Swap Poin</skos:altLabel>
    <skos:altLabel xml:lang="id">SGB</skos:altLabel>
    <skos:altLabel xml:lang="id">kabinet</skos:altLabel>
    <rdfs:comment xml:lang="id">Konsep kokoh K2 {s1,s2,s4}, intensi {swap, booking, mitra}.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#Operator">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bsdo#Agent"/>
    <rdfs:label xml:lang="en">Operator</rdfs:label>
    <rdfs:comment xml:lang="id">Penyelenggara ekosistem battery swap.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#observedAt">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/bsdo#BatteryStateObservation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:label xml:lang="en">observed at</rdfs:label>
    <rdfs:comment xml:lang="id">Saat pengamatan dilakukan. Membatasi BSOR D3 pada keadaan-pada-titik-waktu, bukan lintasan penuh.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#EventCountQuotaPlan">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bsdo#QuotaPlan"/>
    <rdfs:label xml:lang="en">Event-Count Quota Plan</rdfs:label>
    <rdfs:comment xml:lang="id">Kuota dalam jumlah penukaran (Volta: 1/14/50 kali per hari/minggu/bulan).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#BatterySlot">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Battery Slot</rdfs:label>
    <skos:altLabel xml:lang="id">Slot</skos:altLabel>
    <skos:altLabel xml:lang="id">Pintu</skos:altLabel>
    <rdfs:comment xml:lang="id">Istilah asli berbeda per ekosistem: SWAP Energy memakai 'Slot', Volta memakai 'Pintu'. Dipertahankan sebagai altLabel, tidak dinormalisasi.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bsdo#EcosystemArtefact"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ndb82936423794b4b9d8aeb59d29bdab6b12">
    <rdf:first rdf:resource="https://w3id.org/bsdo#ChargingDevice"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ndb82936423794b4b9d8aeb59d29bdab6b10">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:intersectionOf rdf:nodeID="ndb82936423794b4b9d8aeb59d29bdab6b11"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#ServiceEvent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Service Event</rdfs:label>
    <rdfs:label xml:lang="id">Peristiwa Layanan</rdfs:label>
    <rdfs:comment xml:lang="id">Peristiwa terbatas-waktu di mana energi disediakan bagi kendaraan, baik dengan menukar pembawa fisik maupun dengan memindahkan energi ke pembawa yang tetap.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bsdo#EcosystemArtefact"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#hasCustodyDeadlineHours">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/bsdo#ServiceEvent"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="en">custody deadline (hours)</rdfs:label>
    <rdfs:comment xml:lang="id">Batas waktu penguasaan sementara, dalam JAM. Terobservasi: 6 jam pada Tukar Titip dan SCB (manual Volta Membership). CATATAN: xsd:duration sengaja TIDAK dipakai karena bukan bagian dari peta datatype OWL 2 — memakainya akan mengeluarkan ontologi dari profil OWL 2 DL.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <owl:versionIRI rdf:resource="https://w3id.org/bsdo/0.2.0"/>
    <owl:versionInfo>0.2.0-draft</owl:versionInfo>
    <dcterms:title xml:lang="en">BSDO — Battery Swap Domain Ontology</dcterms:title>
    <dcterms:creator>Sido Dea Auvia</dcterms:creator>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <rdfs:comment xml:lang="en">Domain ontology for battery swap ecosystems for electric two-wheelers.
TBox derived from Formal Concept Analysis over four artefact-family contexts (batteries,
station devices, service flows, vehicles), following METHONTOLOGY with FCA substituting the
informal conceptualisation activity. Only concepts robust across pessimistic and optimistic
readings of unarticulated data were promoted to classes.
Aligned to EMMO domain-battery and domain-electrochemistry (the vocabulary layer profiled by
BattINFO). NOTE: the w3id.org/bsdo redirect is not yet registered.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#QuotaPlan">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Prepaid Quota Plan</rdfs:label>
    <rdfs:comment xml:lang="id">Kedua ekosistem memakai pola yang sama: kuota prabayar dengan masa berlaku. Yang berbeda adalah DIMENSI kuotanya.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bsdo#EcosystemArtefact"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#packInserted">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/bsdo#ObjectTransferEvent"/>
    <rdfs:range rdf:resource="https://w3id.org/bsdo#SwappableBattery"/>
    <rdfs:label xml:lang="en">pack inserted into vehicle</rdfs:label>
    <rdfs:comment xml:lang="id">Pak yang dipasang ke kendaraan pada peristiwa transfer objek.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ndb82936423794b4b9d8aeb59d29bdab6b35">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/bsdo#accepts"/>
    <owl:allValuesFrom rdf:resource="https://w3id.org/bsdo#LithiumIonSwappableBattery"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ndb82936423794b4b9d8aeb59d29bdab6b19">
    <rdf:first rdf:nodeID="ndb82936423794b4b9d8aeb59d29bdab6b17"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#Customer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bsdo#Agent"/>
    <rdfs:label xml:lang="en">Customer</rdfs:label>
    <skos:altLabel xml:lang="id">Volters</skos:altLabel>
    <rdfs:comment xml:lang="id">Pengguna akhir. Istilah asli Volta: Volters.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#occursAtDevice">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/bsdo#ServiceEvent"/>
    <rdfs:range rdf:resource="https://w3id.org/bsdo#BatteryHandlingDevice"/>
    <rdfs:label xml:lang="en">occurs at device</rdfs:label>
    <rdfs:comment xml:lang="id">Perangkat tempat peristiwa berlangsung.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#EnergyTransferEvent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bsdo#ServiceEvent"/>
    <rdfs:label xml:lang="en">Energy Transfer Event</rdfs:label>
    <rdfs:comment xml:lang="id">Konsep kokoh K3 {f7} (SCB), intensi {transferEnergi}. Pembawa fisik tidak berpindah.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#LithiumIonSwappableBattery">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:equivalentClass rdf:nodeID="ndb82936423794b4b9d8aeb59d29bdab6b16"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bsdo#SwappableBattery"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/battery#battery_96addc62_ea04_449a_8237_4cd541dd8e5f"/>
    <rdfs:label xml:lang="en">Lithium-Ion Swappable Battery</rdfs:label>
    <rdfs:comment xml:lang="id">SubClassOf SwappableBattery dinyatakan eksplisit meskipun sudah tersirat dari equivalentClass, agar kueri SPARQL atas graf mentah (tanpa reasoner) tetap bekerja.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#Offline">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bsdo#NetworkEnrolmentStatus"/>
    <rdfs:label xml:lang="en">offline</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ndb82936423794b4b9d8aeb59d29bdab6b16">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:intersectionOf rdf:nodeID="ndb82936423794b4b9d8aeb59d29bdab6b18"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ndb82936423794b4b9d8aeb59d29bdab6b20">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:intersectionOf rdf:nodeID="ndb82936423794b4b9d8aeb59d29bdab6b22"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#hasCapacityAh">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/bsdo#SwappableBattery"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="en">capacity (Ah)</rdfs:label>
    <rdfs:comment xml:lang="id">Kapasitas dalam ampere-jam. Satu ekosistem melaporkan Ah, yang lain kWh — satuan tidak sepadan tanpa tegangan aktual.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ndb82936423794b4b9d8aeb59d29bdab6b22">
    <rdf:first rdf:resource="https://w3id.org/bsdo#SwappableBattery"/>
    <rdf:rest rdf:nodeID="ndb82936423794b4b9d8aeb59d29bdab6b23"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/emmo/domain/battery#battery_74ed2670_657d_4f0b_b0a6_3f13bc2e9c17">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Battery (EMMO domain-battery)</rdfs:label>
    <rdfs:comment xml:lang="id">Stub alignment ke EMMO domain-battery:Battery. Dideklarasikan lokal, bukan diimpor: impor penuh modul (4952 kelas) tidak sepadan dengan kebutuhan alignment tunggal ini. IRI diverifikasi terhadap battery-inferred.ttl.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/battery"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ndb82936423794b4b9d8aeb59d29bdab6b9">
    <rdf:first rdf:nodeID="ndb82936423794b4b9d8aeb59d29bdab6b6"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ndb82936423794b4b9d8aeb59d29bdab6b36">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/bsdo#accepts"/>
    <owl:allValuesFrom rdf:resource="https://w3id.org/bsdo#LFPSwappableBattery"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#occursAtSlot">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/bsdo#ServiceEvent"/>
    <rdfs:range rdf:resource="https://w3id.org/bsdo#BatterySlot"/>
    <rdfs:label xml:lang="en">occurs at slot</rdfs:label>
    <rdfs:comment xml:lang="id">Slot atau pintu tempat pak ditempatkan. Istilah asli berbeda per ekosistem.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ndb82936423794b4b9d8aeb59d29bdab6b29">
    <rdf:first rdf:resource="https://w3id.org/bsdo#Offline"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#quotaAmount">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/bsdo#QuotaPlan"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="en">quota amount</rdfs:label>
    <rdfs:comment xml:lang="id">Besaran kuota. SATUANNYA bergantung subkelas: kilometer pada DistanceQuotaPlan, jumlah penukaran pada EventCountQuotaPlan. Keduanya disjoint karena tidak sepadan.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#LithiumIon">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bsdo#CellChemistry"/>
    <rdfs:label xml:lang="en">Lithium-Ion (generic)</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ndb82936423794b4b9d8aeb59d29bdab6b7">
    <rdf:first rdf:resource="https://w3id.org/bsdo#ServiceEvent"/>
    <rdf:rest rdf:nodeID="ndb82936423794b4b9d8aeb59d29bdab6b8"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#mayBeChargedByHolder">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/bsdo#SwappableBattery"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label xml:lang="en">may be charged by holder</rdfs:label>
    <rdfs:comment xml:lang="id">Hak mengelola, TERPISAH dari kepemilikan. Bukti: buku panduan Volta 401 melarang pengisian mandiri; buku panduan Volta Eagle memberi petunjuk pengisian. Pembeda: status pendaftaran jaringan, bukan kepemilikan.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#installationFrom">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/bsdo#BatteryInstallation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:label xml:lang="en">installation from</rdfs:label>
    <rdfs:comment xml:lang="id">Awal episode pemasangan. Menjadikan relasi baterai-kendaraan temporer, bukan mereologis tetap (BSOR D2).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#EcosystemArtefact">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Ecosystem Artefact</rdfs:label>
    <rdfs:label xml:lang="id">Artefak Ekosistem</rdfs:label>
    <rdfs:comment xml:lang="id">Artefak apa pun yang terikat pada satu ekosistem battery swap tertentu. Payung bagi keempat famili objek yang dipakai sebagai konteks formal FCA (model baterai, perangkat stasiun, alur layanan, model kendaraan) serta artefak komersial dan normatif. Keterikatan pada ekosistem inilah yang membuat perbandingan lintas-ekosistem dapat dirumuskan sama sekali.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#BatteryStateObservation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Battery State Observation</rdfs:label>
    <rdfs:comment xml:lang="id">Reifikasi keadaan pak PADA SATU TITIK WAKTU. D3 sengaja dibatasi pada keadaan-saat-transaksi, bukan lintasan ruang-waktu penuh; batas ini dinyatakan di Limitations.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ndb82936423794b4b9d8aeb59d29bdab6b4">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:intersectionOf rdf:nodeID="ndb82936423794b4b9d8aeb59d29bdab6b7"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ndb82936423794b4b9d8aeb59d29bdab6b32">
