    <rdfs:label xml:lang="en">owned by</rdfs:label>
    <rdfs:comment xml:lang="id">Kepemilikan: bertahan melintasi peristiwa layanan.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ndb82936423794b4b9d8aeb59d29bdab6b27">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDifferent"/>
