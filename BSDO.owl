  <rdf:Description rdf:about="https://w3id.org/bsdo#BatteryHandlingDevice">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Battery Handling Device</rdfs:label>
    <rdfs:comment xml:lang="id">Perangkat yang menangani pak baterai, baik dengan menukar maupun mengisi.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bsdo#EcosystemArtefact"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#installedIn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/bsdo#BatteryInstallation"/>
    <rdfs:range rdf:resource="https://w3id.org/bsdo#ElectricMotorcycle"/>
    <rdfs:label xml:lang="en">installed in</rdfs:label>
    <rdfs:comment xml:lang="id">Kendaraan tempat pak terpasang dalam episode ini.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/emmo/domain/battery#battery_96addc62_ea04_449a_8237_4cd541dd8e5f">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">LithiumIonBattery (EMMO domain-battery)</rdfs:label>
    <rdfs:comment xml:lang="id">Stub alignment ke EMMO domain-battery:LithiumIonBattery. IRI diverifikasi terhadap battery-inferred.ttl.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/battery"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#DualFunctionDevice">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:equivalentClass rdf:nodeID="ndb82936423794b4b9d8aeb59d29bdab6b10"/>
    <rdfs:label xml:lang="en">Dual-Function Device</rdfs:label>
    <rdfs:comment xml:lang="id">Perangkat yang melakukan penukaran objek sekaligus transfer energi. Perbedaan arsitektural lintas ekosistem yang hanya muncul karena kedua fungsi dimodelkan sebagai atribut terpisah.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#observationOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/bsdo#BatteryStateObservation"/>
    <rdfs:range rdf:resource="https://w3id.org/bsdo#SwappableBattery"/>
    <rdfs:label xml:lang="en">observation of</rdfs:label>
    <rdfs:comment xml:lang="id">Pak yang keadaannya diamati.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#VoltageClass">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Nominal Voltage Class</rdfs:label>
    <rdfs:comment xml:lang="id">Kelas tegangan nominal terdeklarasi. CATATAN: dimensi ini BERIMPITAN lintas ekosistem (60 V dan 64 V) sehingga TIDAK menentukan kemampuan tukar.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ndb82936423794b4b9d8aeb59d29bdab6b3">
