  <rdf:Description rdf:nodeID="ndb82936423794b4b9d8aeb59d29bdab6b21">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/bsdo#hasCellChemistry"/>
    <owl:hasValue rdf:resource="https://w3id.org/bsdo#LithiumIronPhosphate"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#validityDays">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/bsdo#QuotaPlan"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="en">validity (days)</rdfs:label>
    <rdfs:comment xml:lang="id">Masa berlaku kuota dalam hari. Kuota habis karena terpakai ATAU karena lewat waktu, mana yang lebih dahulu.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ndb82936423794b4b9d8aeb59d29bdab6b30">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/bsdo#hasEnrolmentStatus"/>
    <owl:hasValue rdf:resource="https://w3id.org/bsdo#Online"/>
  </rdf:Description>
