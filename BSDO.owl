  <rdf:Description rdf:about="https://w3id.org/bsdo#SwapEligibilityRule">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Swap Eligibility Rule</rdfs:label>
    <rdfs:comment xml:lang="id">Aturan yang menetapkan kapan sebuah pak dianggap siap ditukar. Terobservasi: SWAP Energy memakai ambang tunggal SoC &gt;= 50%; Volta melaporkan dua bucket (&lt;50% dan &gt;=80%) yang TIDAK mempartisi interval yang sama. Pak pada 65% terklasifikasi oleh yang pertama dan tidak terklasifikasi oleh yang kedua.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bsdo#EcosystemArtefact"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ndb82936423794b4b9d8aeb59d29bdab6b18">
    <rdf:first rdf:resource="https://w3id.org/bsdo#SwappableBattery"/>
    <rdf:rest rdf:nodeID="ndb82936423794b4b9d8aeb59d29bdab6b19"/>
  </rdf:Description>
