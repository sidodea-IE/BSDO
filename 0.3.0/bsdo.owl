<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
  xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
  xmlns:owl="http://www.w3.org/2002/07/owl#"
  xmlns:dcterms="http://purl.org/dc/terms/"
  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
  xmlns:bsdo="https://w3id.org/bsdo#"
  xmlns:skos="http://www.w3.org/2004/02/skos/core#"
>
  <owl:NamedIndividual rdf:about="https://w3id.org/bsdo#VC_72V">
    <rdf:type rdf:resource="https://w3id.org/bsdo#VoltageClass"/>
    <rdfs:label xml:lang="en">72 V</rdfs:label>
    <rdfs:comment xml:lang="en">Source: Value-partition member; no observational source of its own.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:ObjectProperty rdf:about="https://w3id.org/bsdo#declaredBy">
    <rdfs:domain rdf:resource="https://w3id.org/bsdo#SwapEligibilityRule"/>
    <rdfs:range rdf:resource="https://w3id.org/bsdo#Operator"/>
    <rdfs:label xml:lang="en">declared by</rdfs:label>
    <rdfs:comment xml:lang="en">The operator declaring this rule. Eligibility rules are operator-specific rather than a shared standard.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://w3id.org/bsdo#DepositChargingEvent">
    <bsdo:derivationPath xml:lang="en">lattice: K3 concept, extent {f7}, intent includes {energy transfer, ownership retained, same pack returned}. Robust under both readings.</bsdo:derivationPath>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bsdo#EnergyTransferEvent"/>
    <rdfs:label xml:lang="en">Deposit Charging Event</rdfs:label>
    <skos:altLabel xml:lang="id">SCB</skos:altLabel>
    <skos:altLabel xml:lang="id">Sistem Charge Battery</skos:altLabel>
    <rdfs:comment xml:lang="en">The customer's own pack is deposited in a cabinet for charging and later retrieved.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://w3id.org/bsdo#occursAtSlot">
    <rdfs:domain rdf:resource="https://w3id.org/bsdo#ServiceEvent"/>
    <rdfs:range rdf:resource="https://w3id.org/bsdo#BatterySlot"/>
    <rdfs:label xml:lang="en">occurs at slot</rdfs:label>
    <rdfs:comment xml:lang="en">The slot or door in which a pack is placed. The two ecosystems use different native terms.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/bsdo#thresholdPercent">
    <rdfs:domain rdf:resource="https://w3id.org/bsdo#SwapEligibilityRule"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="en">threshold (%)</rdfs:label>
    <rdfs:comment xml:lang="en">The state-of-charge threshold a rule declares. The same numeric value can mean different things: a single eligibility threshold in one ecosystem, a band boundary in the other.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/bsdo#hasCapacityKWh">
    <rdfs:domain rdf:resource="https://w3id.org/bsdo#SwappableBattery"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="en">capacity (kWh)</rdfs:label>
    <rdfs:comment xml:lang="en">Capacity in kilowatt-hours. See the note on capacity in ampere-hours.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://w3id.org/bsdo#LFPOnlyDevice">
    <bsdo:derivationPath xml:lang="en">composed: Composed, not read off K2, for the reason given on Lithium-Ion-Only Device. Obtained from the K1 concept with extent {b3,b4} and intent {LiFePO4, capacity in Ah}, together with the closed-network observation.</bsdo:derivationPath>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bsdo#BatteryHandlingDevice"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="nbd55b8d7039c439cb6e5280c2d0c9009b36">
        <owl:onProperty rdf:resource="https://w3id.org/bsdo#accepts"/>
        <owl:allValuesFrom rdf:resource="https://w3id.org/bsdo#LFPSwappableBattery"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">LiFePO4-Only Device</rdfs:label>
    <rdfs:comment xml:lang="en">A device that accepts only lithium iron phosphate packs.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/bsdo#CustodyPreservingEvent">
    <bsdo:derivationPath xml:lang="en">lattice: K3 concept, extent {f6,f7}, intent includes {6-hour limit, ownership retained, same pack returned}. Robust under both readings. Extent straddles the disjoint transfer split, so the class is defined rather than subsumed; membership is computed by the reasoner.</bsdo:derivationPath>
    <owl:equivalentClass>
      <owl:Class rdf:nodeID="nbd55b8d7039c439cb6e5280c2d0c9009b4">
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="https://w3id.org/bsdo#ServiceEvent"/>
          <owl:Restriction rdf:nodeID="nbd55b8d7039c439cb6e5280c2d0c9009b5">
            <owl:onProperty>
              <owl:DatatypeProperty rdf:about="https://w3id.org/bsdo#hasCustodyDeadlineHours">
                <rdfs:domain rdf:resource="https://w3id.org/bsdo#ServiceEvent"/>
                <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                <rdfs:label xml:lang="en">custody deadline (hours)</rdfs:label>
                <rdfs:comment xml:lang="en">The deadline for temporary custody, expressed in hours. Note that xsd:duration is deliberately not used: it is not part of the OWL 2 datatype map and would place the ontology outside OWL 2 DL.</rdfs:comment>
              </owl:DatatypeProperty>
            </owl:onProperty>
            <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
          </owl:Restriction>
          <owl:Restriction rdf:nodeID="nbd55b8d7039c439cb6e5280c2d0c9009b6">
            <owl:onProperty>
              <owl:ObjectProperty rdf:about="https://w3id.org/bsdo#returnsPackTo">
                <rdfs:domain rdf:resource="https://w3id.org/bsdo#ServiceEvent"/>
                <rdfs:range rdf:resource="https://w3id.org/bsdo#Agent"/>
                <rdfs:label xml:lang="en">returns pack to</rdfs:label>
                <rdfs:comment xml:lang="en">The party to whom a pack is returned at the end of an event. Present only on events that preserve ownership.</rdfs:comment>
              </owl:ObjectProperty>
            </owl:onProperty>
            <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
    <rdfs:label xml:lang="en">Custody-Preserving Event</rdfs:label>
    <rdfs:comment xml:lang="en">Events in which custody transfers temporarily while ownership does not. Membership is inferred rather than asserted, and deliberately crosses the object-transfer / energy-transfer partition: in a loan event the customer holds an operator's pack, whereas in a deposit-charging event the operator holds the customer's pack.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/bsdo#SwapEvent">
    <bsdo:derivationPath xml:lang="en">composed: K3: the object-transfer flows lacking {same pack returned}. A complement within a robust concept, not itself a closed extent.</bsdo:derivationPath>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bsdo#ObjectTransferEvent"/>
    <rdfs:label xml:lang="en">Swap Event</rdfs:label>
    <rdfs:comment xml:lang="en">An exchange in which the outgoing pack does not return to the customer.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://w3id.org/bsdo#occursAtDevice">
    <rdfs:domain rdf:resource="https://w3id.org/bsdo#ServiceEvent"/>
    <rdfs:range rdf:resource="https://w3id.org/bsdo#BatteryHandlingDevice"/>
    <rdfs:label xml:lang="en">occurs at device</rdfs:label>
    <rdfs:comment xml:lang="en">The device at which an event takes place.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/bsdo#hasQualitativeHealthLabel">
    <rdfs:domain rdf:resource="https://w3id.org/bsdo#BatteryStateObservation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:seeAlso rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_a7a4614f_2426_46f3_8475_cda4a9fabfce"/>
    <rdfs:comment xml:lang="en">Deliberately typed as a string rather than a numeric quantity. One ecosystem exposes a qualitative badge whose scale, thresholds and derivation method are undisclosed; the other exposes nothing. Typing it numerically would imply a comparability the sources do not support.</rdfs:comment>
    <rdfs:label xml:lang="en">qualitative health label</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/bsdo#hasStateOfCharge">
    <rdfs:domain rdf:resource="https://w3id.org/bsdo#BatteryStateObservation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:seeAlso rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_8b2aaa50_bbe1_45da_8778_8898326246a2"/>
    <rdfs:comment xml:lang="en">Aligned to StateOfCharge in the EMMO domain-electrochemistry module. The StateOfCharge class in the domain-battery namespace is deprecated and is not used here.</rdfs:comment>
    <rdfs:label xml:lang="en">state of charge (%)</rdfs:label>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/bsdo#hasParticipantCustomer">
    <rdfs:domain rdf:resource="https://w3id.org/bsdo#ServiceEvent"/>
    <rdfs:range rdf:resource="https://w3id.org/bsdo#Customer"/>
    <rdfs:label xml:lang="en">has participant customer</rdfs:label>
    <rdfs:comment xml:lang="en">The customer participating in a service event.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/bsdo#installedPack">
    <rdfs:domain rdf:resource="https://w3id.org/bsdo#BatteryInstallation"/>
    <rdfs:range rdf:resource="https://w3id.org/bsdo#SwappableBattery"/>
    <rdfs:label xml:lang="en">installed pack</rdfs:label>
    <rdfs:comment xml:lang="en">The pack installed in the vehicle during this installation episode.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/bsdo#hasCapacityAh">
    <rdfs:domain rdf:resource="https://w3id.org/bsdo#SwappableBattery"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="en">capacity (Ah)</rdfs:label>
    <rdfs:comment xml:lang="en">Capacity in ampere-hours. The two ecosystems report capacity in different units, which are not convertible without the actual rather than nominal voltage.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://w3id.org/bsdo#LoanEvent">
    <bsdo:derivationPath xml:lang="en">lattice: K3 concept, extent {f6}, intent includes {borrowed pack, ownership retained, same pack returned}. Robust under both readings.</bsdo:derivationPath>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bsdo#ObjectTransferEvent"/>
    <rdfs:label xml:lang="en">Loan Event</rdfs:label>
    <skos:altLabel xml:lang="id">Tukar Titip</skos:altLabel>
    <rdfs:comment xml:lang="en">An exchange in which the customer receives a borrowed pack and later returns it, within a stated deadline, in exchange for their own.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/bsdo#LithiumIonOnlyDevice">
    <bsdo:derivationPath xml:lang="en">composed: Composed, not read off K2: cell chemistry is not an attribute of any station in K2, because no operator states which chemistry its devices accept. Obtained from the K1 concept with extent {b1,b2} and intent including {Li-ion}, together with the observation that each network serves only its own packs.</bsdo:derivationPath>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bsdo#BatteryHandlingDevice"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="nbd55b8d7039c439cb6e5280c2d0c9009b35">
        <owl:onProperty rdf:resource="https://w3id.org/bsdo#accepts"/>
        <owl:allValuesFrom rdf:resource="https://w3id.org/bsdo#LithiumIonSwappableBattery"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">Lithium-Ion-Only Device</rdfs:label>
    <rdfs:comment xml:lang="en">A device that accepts only lithium-ion packs. The value restriction declared here is what makes incompatibility detectable as an inconsistency.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://w3id.org/bsdo#installationFrom">
    <rdfs:domain rdf:resource="https://w3id.org/bsdo#BatteryInstallation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:label xml:lang="en">installation from</rdfs:label>
    <rdfs:comment xml:lang="en">The start of an installation episode, which makes the battery-vehicle relation temporary rather than a fixed part-whole.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/bsdo#validityDays">
    <rdfs:domain rdf:resource="https://w3id.org/bsdo#QuotaPlan"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="en">validity (days)</rdfs:label>
    <rdfs:comment xml:lang="en">The validity period of a quota in days. A quota is exhausted either by use or by expiry, whichever comes first.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/bsdo#heldBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/bsdo#SwappableBattery"/>
    <rdfs:range rdf:resource="https://w3id.org/bsdo#Agent"/>
    <rdfs:label xml:lang="en">held by</rdfs:label>
    <rdfs:comment xml:lang="en">Current physical custody. Functional: a pack is held by at most one party at a time. Custody can diverge from ownership, and changes at every exchange.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/bsdo#eventTime">
    <rdfs:domain rdf:resource="https://w3id.org/bsdo#ServiceEvent"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:label xml:lang="en">event time</rdfs:label>
    <rdfs:comment xml:lang="en">The time at which an event occurred. Generally unpopulated: transaction payloads could not be observed from available sources.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:Ontology rdf:about="https://w3id.org/bsdo">
    <owl:versionIRI rdf:resource="https://w3id.org/bsdo/0.3.0"/>
    <owl:versionInfo>0.3.0</owl:versionInfo>
    <owl:priorVersion rdf:resource="https://w3id.org/bsdo/0.2.0"/>
    <dcterms:title xml:lang="en">BSDO — Battery Swap Domain Ontology</dcterms:title>
    <dcterms:creator>Sido Dea Auvia</dcterms:creator>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <rdfs:comment xml:lang="en">Domain ontology for battery swap ecosystems for electric two-wheelers.
TBox derived from Formal Concept Analysis over four artefact-family contexts (batteries,
station devices, service flows, vehicles), following METHONTOLOGY with FCA substituting the
informal conceptualisation activity. Where a class comes from a formal concept, only concepts
robust across pessimistic and optimistic readings of unarticulated data were promoted. Classes
that are not formal concepts are marked as such: every class carries bsdo:derivationPath, whose
value begins with one of lattice, composed, reuse or structural.
Aligned to EMMO domain-battery and domain-electrochemistry (the vocabulary layer profiled by
BattINFO).</rdfs:comment>
  </owl:Ontology>
  <owl:ObjectProperty rdf:about="https://w3id.org/bsdo#packRemoved">
    <rdfs:domain rdf:resource="https://w3id.org/bsdo#ObjectTransferEvent"/>
    <rdfs:range rdf:resource="https://w3id.org/bsdo#SwappableBattery"/>
    <rdfs:label xml:lang="en">pack removed from vehicle</rdfs:label>
    <rdfs:comment xml:lang="en">The pack removed from the vehicle during an object-transfer event.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:AnnotationProperty rdf:about="https://w3id.org/bsdo#derivationPath">
    <rdfs:label xml:lang="en">derivation path</rdfs:label>
    <rdfs:comment xml:lang="en">How the annotated class was obtained. The value opens with one of four
provenance kinds: 'lattice' (a formal concept robust under both readings of the unarticulated
cells, with context, extent and intent named), 'composed' (a concept from one context combined
with an observation not carried by that context), 'reuse' (taken from an aligned external
vocabulary), or 'structural' (scaffolding: value partitions, n-ary reifications, genus nodes and
role classes). Extents are given as object identifiers of the published formal contexts, so that
each claim can be checked against context_K*.csv and recomputed with lattice.py.</rdfs:comment>
  </owl:AnnotationProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/bsdo#quotaAmount">
    <rdfs:domain rdf:resource="https://w3id.org/bsdo#QuotaPlan"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="en">quota amount</rdfs:label>
    <rdfs:comment xml:lang="en">The quota amount. Its unit depends on the subclass: kilometres for a distance plan, exchange events for an event-count plan. The two are disjoint because they are not commensurable.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/bsdo#hasUnitIdentifier">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/bsdo#SwappableBattery"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">unit identifier</rdfs:label>
    <rdfs:comment xml:lang="en">A persistent unit identifier, independent of any vehicle. Both ecosystems maintain such identifiers, but under mutually uninterpretable schemes, and neither follows the identification standard required of battery passports by Regulation (EU) 2023/1542.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/bsdo#acceptsChemistry">
    <rdfs:domain rdf:resource="https://w3id.org/bsdo#BatteryHandlingDevice"/>
    <rdfs:range rdf:resource="https://w3id.org/bsdo#CellChemistry"/>
    <rdfs:label xml:lang="en">accepts chemistry</rdfs:label>
    <rdfs:comment xml:lang="en">The cell chemistry a device can serve. Together with the disjointness of the chemistry classes, this is what makes incompatibility derivable as a logical inconsistency.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/bsdo#installedIn">
    <rdfs:domain rdf:resource="https://w3id.org/bsdo#BatteryInstallation"/>
    <rdfs:range rdf:resource="https://w3id.org/bsdo#ElectricMotorcycle"/>
    <rdfs:label xml:lang="en">installed in</rdfs:label>
    <rdfs:comment xml:lang="en">The vehicle in which the pack is installed during this episode.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:AllDifferent rdf:nodeID="nbd55b8d7039c439cb6e5280c2d0c9009b27">
    <owl:distinctMembers rdf:parseType="Collection">
      <rdf:Description rdf:about="https://w3id.org/bsdo#Online"/>
      <rdf:Description rdf:about="https://w3id.org/bsdo#Offline"/>
    </owl:distinctMembers>
  </owl:AllDifferent>
  <owl:Class rdf:about="https://w3id.org/bsdo#NetworkEnrolledBattery">
    <bsdo:derivationPath xml:lang="en">composed: Composed: the {network enrolment} attribute is observed of K3 service flows, not of battery models. Applied to packs on the strength of the manufacturer documentation governing enrolled units. Defined class; membership computed by the reasoner.</bsdo:derivationPath>
    <owl:equivalentClass>
      <owl:Restriction rdf:nodeID="nbd55b8d7039c439cb6e5280c2d0c9009b30">
        <owl:onProperty rdf:resource="https://w3id.org/bsdo#hasEnrolmentStatus"/>
        <owl:hasValue rdf:resource="https://w3id.org/bsdo#Online"/>
      </owl:Restriction>
    </owl:equivalentClass>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="nbd55b8d7039c439cb6e5280c2d0c9009b31">
        <owl:onProperty rdf:resource="https://w3id.org/bsdo#mayBeChargedByHolder"/>
        <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</owl:hasValue>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">Network-Enrolled Battery</rdfs:label>
    <rdfs:comment xml:lang="en">A pack enrolled in an operator's network: ownership remains with the customer while the right to charge rests with the operator.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://w3id.org/bsdo#packInserted">
    <rdfs:domain rdf:resource="https://w3id.org/bsdo#ObjectTransferEvent"/>
    <rdfs:range rdf:resource="https://w3id.org/bsdo#SwappableBattery"/>
    <rdfs:label xml:lang="en">pack inserted into vehicle</rdfs:label>
    <rdfs:comment xml:lang="en">The pack inserted into the vehicle during an object-transfer event.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://w3id.org/bsdo#DualFunctionDevice">
    <bsdo:derivationPath xml:lang="en">lattice: K2 concept, extent {s4}, intent includes both {exchange} and {charging}. Robust under both readings; defined class, membership computed by the reasoner.</bsdo:derivationPath>
    <owl:equivalentClass>
      <owl:Class rdf:nodeID="nbd55b8d7039c439cb6e5280c2d0c9009b10">
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="https://w3id.org/bsdo#SwapDevice"/>
          <rdf:Description rdf:about="https://w3id.org/bsdo#ChargingDevice"/>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
    <rdfs:label xml:lang="en">Dual-Function Device</rdfs:label>
    <rdfs:comment xml:lang="en">A device performing both object exchange and energy transfer. One ecosystem separates these functions across distinct appliances; the other combines them in a single cabinet. The distinction becomes visible only because the two functions are modelled as separate attributes.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://w3id.org/bsdo#operatedBy">
    <rdfs:range rdf:resource="https://w3id.org/bsdo#Operator"/>
    <rdfs:label xml:lang="en">operated by</rdfs:label>
    <rdfs:comment xml:lang="en">Relates an artefact to the operator whose ecosystem it belongs to. Ecosystem membership is what makes cross-ecosystem comparison expressible at all.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/bsdo#EcosystemArtefact"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/bsdo#hasVoltageClass">
    <rdfs:domain rdf:resource="https://w3id.org/bsdo#SwappableBattery"/>
    <rdfs:range rdf:resource="https://w3id.org/bsdo#VoltageClass"/>
    <rdfs:comment xml:lang="en">Deliberately not functional: a single product may carry more than one declared voltage class when different sources of the same operator label it differently. Non-functionality records that instability rather than resolving it.</rdfs:comment>
    <rdfs:comment xml:lang="en">The declared nominal voltage class. Not functional, since one artefact may carry more than one declaration from different sources.</rdfs:comment>
    <rdfs:label xml:lang="en">has voltage class</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/bsdo#observationOf">
    <rdfs:domain rdf:resource="https://w3id.org/bsdo#BatteryStateObservation"/>
    <rdfs:range rdf:resource="https://w3id.org/bsdo#SwappableBattery"/>
    <rdfs:label xml:lang="en">observation of</rdfs:label>
    <rdfs:comment xml:lang="en">The pack whose state is observed.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/bsdo#ownedBy">
    <rdfs:domain rdf:resource="https://w3id.org/bsdo#SwappableBattery"/>
    <rdfs:range rdf:resource="https://w3id.org/bsdo#Agent"/>
    <rdfs:label xml:lang="en">owned by</rdfs:label>
    <rdfs:comment xml:lang="en">Ownership, which persists across service events.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:AllDisjointClasses rdf:nodeID="nbd55b8d7039c439cb6e5280c2d0c9009b1">
    <owl:members rdf:parseType="Collection">
      <rdf:Description rdf:about="https://w3id.org/bsdo#ObjectTransferEvent"/>
      <rdf:Description rdf:about="https://w3id.org/bsdo#EnergyTransferEvent"/>
    </owl:members>
  </owl:AllDisjointClasses>
  <owl:NamedIndividual rdf:about="https://w3id.org/bsdo#VC_64V">
    <rdf:type rdf:resource="https://w3id.org/bsdo#VoltageClass"/>
    <rdfs:label xml:lang="en">64 V</rdfs:label>
    <rdfs:comment xml:lang="en">Source: Value-partition member; no observational source of its own.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:ObjectProperty rdf:about="https://w3id.org/bsdo#hasIdentifierScheme">
    <rdfs:domain rdf:resource="https://w3id.org/bsdo#SwappableBattery"/>
    <rdfs:range rdf:resource="https://w3id.org/bsdo#IdentifierScheme"/>
    <rdfs:label xml:lang="en">has identifier scheme</rdfs:label>
    <rdfs:comment xml:lang="en">The numbering scheme of a unit identifier. The two ecosystems use mutually uninterpretable schemes, which is the first mapping any roaming arrangement must resolve.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:AllDisjointClasses rdf:nodeID="nbd55b8d7039c439cb6e5280c2d0c9009b32">
    <owl:members rdf:parseType="Collection">
      <rdf:Description rdf:about="https://w3id.org/bsdo#DistanceQuotaPlan"/>
      <rdf:Description rdf:about="https://w3id.org/bsdo#EventCountQuotaPlan"/>
    </owl:members>
  </owl:AllDisjointClasses>
  <owl:AllDifferent rdf:nodeID="nbd55b8d7039c439cb6e5280c2d0c9009b13">
    <owl:distinctMembers rdf:parseType="Collection">
      <rdf:Description rdf:about="https://w3id.org/bsdo#LithiumIon"/>
      <rdf:Description rdf:about="https://w3id.org/bsdo#LithiumIronPhosphate"/>
    </owl:distinctMembers>
  </owl:AllDifferent>
  <owl:DatatypeProperty rdf:about="https://w3id.org/bsdo#observedAt">
    <rdfs:domain rdf:resource="https://w3id.org/bsdo#BatteryStateObservation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:label xml:lang="en">observed at</rdfs:label>
    <rdfs:comment xml:lang="en">The time of observation, which bounds temporal representation to state at a point in time rather than a full trajectory.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:NamedIndividual rdf:about="https://w3id.org/bsdo#VC_60V">
    <rdf:type rdf:resource="https://w3id.org/bsdo#VoltageClass"/>
    <rdfs:label xml:lang="en">60 V</rdfs:label>
    <rdfs:comment xml:lang="en">Source: Value-partition member; no observational source of its own.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:AllDisjointClasses rdf:nodeID="nbd55b8d7039c439cb6e5280c2d0c9009b24">
    <owl:members rdf:parseType="Collection">
      <rdf:Description rdf:about="https://w3id.org/bsdo#LithiumIonSwappableBattery"/>
      <rdf:Description rdf:about="https://w3id.org/bsdo#LFPSwappableBattery"/>
    </owl:members>
  </owl:AllDisjointClasses>
  <owl:Class rdf:about="https://w3id.org/bsdo#NetworkEnrolmentStatus">
    <rdfs:label xml:lang="en">Network Enrolment Status</rdfs:label>
    <bsdo:derivationPath xml:lang="en">structural: Value partition over the network-enrolment attribute observed in K3.</bsdo:derivationPath>
    <rdfs:comment xml:lang="en">A pack's network enrolment status: enrolled or not enrolled.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/bsdo#BatterySlot">
    <bsdo:derivationPath xml:lang="en">structural: Introduced to carry the per-slot status observed on K2 objects s2 and s4. Native operator terms are retained as alternative labels rather than normalised away.</bsdo:derivationPath>
    <rdfs:label xml:lang="en">Battery Slot</rdfs:label>
    <skos:altLabel xml:lang="id">Slot</skos:altLabel>
    <skos:altLabel xml:lang="id">Pintu</skos:altLabel>
    <rdfs:comment xml:lang="en">The two ecosystems use different native terms for this concept. Both are retained as alternative labels rather than normalised to a single term.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bsdo#EcosystemArtefact"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://w3id.org/bsdo#hasCellChemistry">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/bsdo#SwappableBattery"/>
    <rdfs:range rdf:resource="https://w3id.org/bsdo#CellChemistry"/>
    <rdfs:label xml:lang="en">has cell chemistry</rdfs:label>
    <rdfs:comment xml:lang="en">The cell chemistry declared by the manufacturer. This is the dimension on which interchange actually fails.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://w3id.org/bsdo#SwapEligibilityRule">
    <bsdo:derivationPath xml:lang="en">structural: Observed normative artefact: operator-declared readiness thresholds. Modelled as an operator-relative rule so that the two incompatible definitions can coexist; not a formal-context object.</bsdo:derivationPath>
    <rdfs:label xml:lang="en">Swap Eligibility Rule</rdfs:label>
    <rdfs:comment xml:lang="en">A rule stating when a pack counts as ready to be exchanged. Eligibility is operator-relative: the two ecosystems declare thresholds that do not partition the same interval, so the predicate has no ontology-wide extension.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bsdo#EcosystemArtefact"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/bsdo#ChargingDevice">
    <bsdo:derivationPath xml:lang="en">lattice: K2 concept, extent {s3,s4}, intent {charging}. Robust under both readings; extent spans both ecosystems, which is why this class is not disjoint from Swap Device.</bsdo:derivationPath>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bsdo#BatteryHandlingDevice"/>
    <rdfs:label xml:lang="en">Charging Device</rdfs:label>
    <rdfs:comment xml:lang="en">A device that transfers energy into a battery pack in place.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/bsdo#LithiumIonSwappableBattery">
    <bsdo:derivationPath xml:lang="en">lattice: K1 concept, extent {b1,b2}, intent includes {Li-ion, capacity in kWh}. Robust under both readings.</bsdo:derivationPath>
    <owl:equivalentClass>
      <owl:Class rdf:nodeID="nbd55b8d7039c439cb6e5280c2d0c9009b16">
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="https://w3id.org/bsdo#SwappableBattery"/>
          <owl:Restriction rdf:nodeID="nbd55b8d7039c439cb6e5280c2d0c9009b17">
            <owl:onProperty rdf:resource="https://w3id.org/bsdo#hasCellChemistry"/>
            <owl:hasValue>
              <owl:NamedIndividual rdf:about="https://w3id.org/bsdo#LithiumIon">
                <rdf:type rdf:resource="https://w3id.org/bsdo#CellChemistry"/>
                <rdfs:label xml:lang="en">Lithium-Ion (generic)</rdfs:label>
                <rdfs:comment xml:lang="en">Source: Value-partition member; no observational source of its own. Not aligned at substance level: the EMMO chemical-substance module enumerates specific electrode and electrolyte materials, and the operator declares only a generic cell family without naming a cathode material, so no substance-level target corresponds. The lithium-ion side is instead aligned at battery level, on Lithium-Ion Swappable Battery.</rdfs:comment>
              </owl:NamedIndividual>
            </owl:hasValue>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bsdo#SwappableBattery"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/battery#battery_96addc62_ea04_449a_8237_4cd541dd8e5f"/>
    <rdfs:label xml:lang="en">Lithium-Ion Swappable Battery</rdfs:label>
    <rdfs:comment xml:lang="en">The subclass axiom is stated explicitly although it is entailed by the equivalent-class definition, so that SPARQL queries over the raw graph work without a reasoner.</rdfs:comment>
  </owl:Class>
  <owl:NamedIndividual rdf:about="https://w3id.org/bsdo#LithiumIronPhosphate">
    <rdf:type rdf:resource="https://w3id.org/bsdo#CellChemistry"/>
    <rdfs:label xml:lang="en">LiFePO4</rdfs:label>
    <rdfs:seeAlso rdf:resource="https://w3id.org/emmo/domain/chemical-substance#substance_aa8e9cc4_5f66_4307_b1c8_26fac7653a90"/>
    <rdfs:comment xml:lang="en">Source: Value-partition member; no observational source of its own. Aligned to LithiumIronPhosphate (altLabel LFP) in the EMMO chemical-substance module, by reference rather than import, following the pattern used for the electrochemistry quantities. The target was verified against the module's published file.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:Class rdf:about="https://w3id.org/emmo/domain/battery#battery_96addc62_ea04_449a_8237_4cd541dd8e5f">
    <rdfs:label xml:lang="en">LithiumIonBattery (EMMO domain-battery)</rdfs:label>
    <rdfs:comment xml:lang="en">Alignment stub for the LithiumIonBattery class of the EMMO domain-battery module.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/battery"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://w3id.org/bsdo#mayBeChargedByHolder">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/bsdo#SwappableBattery"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label xml:lang="en">may be charged by holder</rdfs:label>
    <rdfs:comment xml:lang="en">The right to charge a pack, which is separate from owning it. The same physical pack may fall under different rights regimes depending on its network enrolment status, with ownership unchanged throughout.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://w3id.org/bsdo#QuotaPlan">
    <bsdo:derivationPath xml:lang="en">structural: Genus for the commercial artefacts, which were observed but not admitted to a formal context.</bsdo:derivationPath>
    <rdfs:label xml:lang="en">Prepaid Quota Plan</rdfs:label>
    <rdfs:comment xml:lang="en">Both ecosystems sell prepaid quota with an expiry period. What differs is the dimension in which the quota is denominated.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bsdo#EcosystemArtefact"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/bsdo#Operator">
    <rdfs:subClassOf rdf:resource="https://w3id.org/bsdo#Agent"/>
    <rdfs:label xml:lang="en">Operator</rdfs:label>
    <bsdo:derivationPath xml:lang="en">structural: Role scaffold; see Agent.</bsdo:derivationPath>
    <rdfs:comment xml:lang="en">An operator of a battery swap ecosystem.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/bsdo#SwapDevice">
    <bsdo:derivationPath xml:lang="en">lattice: K2 concept, extent {s1,s2,s4}, intent {exchange, booking, host partner}. Robust under both readings; extent spans both ecosystems.</bsdo:derivationPath>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bsdo#BatteryHandlingDevice"/>
    <rdfs:label xml:lang="en">Swap Device</rdfs:label>
    <skos:altLabel xml:lang="id">BSS</skos:altLabel>
    <skos:altLabel xml:lang="id">Swap Poin</skos:altLabel>
    <skos:altLabel xml:lang="id">SGB</skos:altLabel>
    <skos:altLabel xml:lang="id">kabinet</skos:altLabel>
    <rdfs:comment xml:lang="en">A device that exchanges battery packs.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://w3id.org/bsdo#hasEnrolmentStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/bsdo#SwappableBattery"/>
    <rdfs:range rdf:resource="https://w3id.org/bsdo#NetworkEnrolmentStatus"/>
    <rdfs:label xml:lang="en">has enrolment status</rdfs:label>
    <rdfs:comment xml:lang="en">A pack's enrolment status in an operator's network. This determines the right to manage the pack, not its ownership.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://w3id.org/bsdo#BatteryHandlingDevice">
    <bsdo:derivationPath xml:lang="en">structural: Genus for the K2 artefact family. Not itself a closed concept.</bsdo:derivationPath>
    <rdfs:label xml:lang="en">Battery Handling Device</rdfs:label>
    <rdfs:comment xml:lang="en">A device that handles battery packs, whether by exchanging or by charging them.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bsdo#EcosystemArtefact"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/bsdo#DistanceQuotaPlan">
    <bsdo:derivationPath xml:lang="en">structural: Observed commercial artefact: quota denominated in distance. Not a formal-context object; disjointness with the event-count plan records an incommensurability, not a lattice result.</bsdo:derivationPath>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bsdo#QuotaPlan"/>
    <rdfs:label xml:lang="en">Distance Quota Plan</rdfs:label>
    <rdfs:comment xml:lang="en">Quota denominated in kilometres travelled.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/bsdo#SwappableBattery">
    <bsdo:derivationPath xml:lang="en">reuse: Reuse: subclass of the Battery class of the EMMO domain-battery module. Corresponds to the K1 top concept, whose intent is empty and therefore carries no discriminating attribute of its own.</bsdo:derivationPath>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/battery#battery_74ed2670_657d_4f0b_b0a6_3f13bc2e9c17"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bsdo#EcosystemArtefact"/>
    <rdfs:label xml:lang="en">Swappable Battery</rdfs:label>
    <rdfs:comment xml:lang="en">Aligned to the Battery class of the EMMO domain-battery module, which is the vocabulary layer that the BattINFO application ontology profiles.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://w3id.org/bsdo#accepts">
    <rdfs:domain rdf:resource="https://w3id.org/bsdo#BatteryHandlingDevice"/>
    <rdfs:range rdf:resource="https://w3id.org/bsdo#SwappableBattery"/>
    <rdfs:comment xml:lang="en">The packs a device can serve. Never asserted directly; constrained by chemistry axioms so that incompatibility surfaces as a logical inconsistency rather than as an empty query result.</rdfs:comment>
    <rdfs:label xml:lang="en">accepts</rdfs:label>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://w3id.org/bsdo#IdentifierScheme">
    <rdfs:label xml:lang="en">Identifier Scheme</rdfs:label>
    <bsdo:derivationPath xml:lang="en">structural: Observed per-ecosystem identifier schemes, retained as pattern only. Not a formal-context object.</bsdo:derivationPath>
    <rdfs:comment xml:lang="en">A unit identifier scheme, specific to an ecosystem.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/bsdo#LFPSwappableBattery">
    <bsdo:derivationPath xml:lang="en">lattice: K1 concept, extent {b3,b4}, intent {LiFePO4, capacity in Ah}. Robust under both readings.</bsdo:derivationPath>
    <owl:equivalentClass>
      <owl:Class rdf:nodeID="nbd55b8d7039c439cb6e5280c2d0c9009b20">
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="https://w3id.org/bsdo#SwappableBattery"/>
          <owl:Restriction rdf:nodeID="nbd55b8d7039c439cb6e5280c2d0c9009b21">
            <owl:onProperty rdf:resource="https://w3id.org/bsdo#hasCellChemistry"/>
            <owl:hasValue rdf:resource="https://w3id.org/bsdo#LithiumIronPhosphate"/>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bsdo#SwappableBattery"/>
    <rdfs:label xml:lang="en">LiFePO4 Swappable Battery</rdfs:label>
    <rdfs:comment xml:lang="en">A swappable pack with lithium iron phosphate chemistry. Disjoint with the lithium-ion class.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/bsdo#ServiceEvent">
    <bsdo:derivationPath xml:lang="en">structural: Genus for the K3 artefact family; the node under which the transfer split is drawn. Not itself a closed concept.</bsdo:derivationPath>
    <rdfs:label xml:lang="en">Service Event</rdfs:label>
    <rdfs:comment xml:lang="en">A bounded event in which energy is supplied to a vehicle, either by exchanging the physical carrier or by transferring energy into a carrier that remains in place.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bsdo#EcosystemArtefact"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/bsdo#ObjectTransferEvent">
    <bsdo:derivationPath xml:lang="en">lattice: K3 concept, extent {f1,f2,f3,f4,f5,f6}, intent {object transfer}. Robust under both readings; extent spans both ecosystems.</bsdo:derivationPath>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bsdo#ServiceEvent"/>
    <rdfs:label xml:lang="en">Object Transfer Event</rdfs:label>
    <rdfs:comment xml:lang="en">Events in which the physical carrier is exchanged. Derived from a formal concept spanning six service flows drawn from both ecosystems, so the distinction is not an artefact of one operator's product line.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/bsdo#Customer">
    <rdfs:subClassOf rdf:resource="https://w3id.org/bsdo#Agent"/>
    <rdfs:label xml:lang="en">Customer</rdfs:label>
    <bsdo:derivationPath xml:lang="en">structural: Role scaffold; see Agent.</bsdo:derivationPath>
    <skos:altLabel xml:lang="id">Volters</skos:altLabel>
    <rdfs:comment xml:lang="en">An end user of a battery swap service.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/bsdo#ElectricMotorcycle">
    <bsdo:derivationPath xml:lang="en">structural: K4 artefact family. K4 yields a full Boolean lattice on three objects under both readings, so no attribute implication holds; the family is reported as a specification table rather than as a lattice, and this class carries no concept-derived intent.</bsdo:derivationPath>
    <rdfs:label xml:lang="en">Electric Motorcycle</rdfs:label>
    <rdfs:comment xml:lang="en">An electric two-wheeler using swappable batteries. Its relation to a pack is temporary; see BatteryInstallation.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bsdo#EcosystemArtefact"/>
  </owl:Class>
  <owl:NamedIndividual rdf:about="https://w3id.org/bsdo#Online">
    <rdf:type rdf:resource="https://w3id.org/bsdo#NetworkEnrolmentStatus"/>
    <rdfs:label xml:lang="en">online</rdfs:label>
    <rdfs:comment xml:lang="en">Source: Value-partition member; no observational source of its own.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:Class rdf:about="https://w3id.org/bsdo#EcosystemArtefact">
    <bsdo:derivationPath xml:lang="en">structural: Umbrella introduced in response to pitfall P11. It names the ecosystem-binding that the formal-context design had assumed implicitly, since all four artefact families are ecosystem-bound.</bsdo:derivationPath>
    <rdfs:label xml:lang="en">Ecosystem Artefact</rdfs:label>
    <rdfs:comment xml:lang="en">Any artefact bound to a particular battery swap ecosystem: battery models, station devices, service flows, vehicle models, and the commercial and normative artefacts that accompany them. This binding is what makes cross-ecosystem comparison expressible.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/bsdo#EventCountQuotaPlan">
    <bsdo:derivationPath xml:lang="en">structural: Observed commercial artefact: quota denominated in exchange events. See Distance Quota Plan.</bsdo:derivationPath>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bsdo#QuotaPlan"/>
    <rdfs:label xml:lang="en">Event-Count Quota Plan</rdfs:label>
    <rdfs:comment xml:lang="en">Quota denominated in number of exchange events.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/bsdo#CellChemistry">
    <bsdo:derivationPath xml:lang="en">structural: Value partition (Rector 2005) over the chemistry attributes of K1.</bsdo:derivationPath>
    <rdfs:label xml:lang="en">Cell Chemistry</rdfs:label>
    <rdfs:comment xml:lang="en">Cell chemistry as an enumerated value.</rdfs:comment>
  </owl:Class>
  <owl:NamedIndividual rdf:about="https://w3id.org/bsdo#Offline">
    <rdf:type rdf:resource="https://w3id.org/bsdo#NetworkEnrolmentStatus"/>
    <rdfs:label xml:lang="en">offline</rdfs:label>
    <rdfs:comment xml:lang="en">Source: Value-partition member; no observational source of its own.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:Class rdf:about="https://w3id.org/emmo/domain/battery#battery_74ed2670_657d_4f0b_b0a6_3f13bc2e9c17">
    <rdfs:label xml:lang="en">Battery (EMMO domain-battery)</rdfs:label>
    <rdfs:comment xml:lang="en">Alignment stub for the Battery class of the EMMO domain-battery module. Declared locally rather than imported: importing the full module would introduce several thousand classes to obtain a single subsumption relation.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/battery"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/bsdo#VoltageClass">
    <bsdo:derivationPath xml:lang="en">structural: Value partition over the voltage attributes of K1. Not functional, since one battery model carries two declared classes.</bsdo:derivationPath>
    <rdfs:label xml:lang="en">Nominal Voltage Class</rdfs:label>
    <rdfs:comment xml:lang="en">Declared nominal voltage class. This dimension overlaps across the ecosystems studied and therefore does not determine whether packs can be interchanged.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/bsdo#Agent">
    <rdfs:label xml:lang="en">Agent</rdfs:label>
    <bsdo:derivationPath xml:lang="en">structural: Role scaffold; not ecosystem-bound and not a formal-context object.</bsdo:derivationPath>
    <rdfs:comment xml:lang="en">A party that can own or hold a battery pack.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/bsdo#EnergyTransferEvent">
    <bsdo:derivationPath xml:lang="en">lattice: K3 concept, extent {f7}, intent includes {energy transfer}. Robust under both readings.</bsdo:derivationPath>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bsdo#ServiceEvent"/>
    <rdfs:label xml:lang="en">Energy Transfer Event</rdfs:label>
    <rdfs:comment xml:lang="en">Events in which energy is transferred without exchanging the physical carrier.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/bsdo#BatteryInstallation">
    <bsdo:derivationPath xml:lang="en">structural: N-ary relation pattern (Noy and Rector 2006): reification of the pack-vehicle association so the relation can be temporary. A modelling construct, not a concept.</bsdo:derivationPath>
    <rdfs:label xml:lang="en">Battery Installation</rdfs:label>
    <rdfs:comment xml:lang="en">Reification of the association between a pack and a vehicle. This is deliberately not modelled as a mereological part-whole relation: in a swap domain a pack moves between vehicles, so a fixed relation would be false.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/bsdo#BatteryStateObservation">
    <bsdo:derivationPath xml:lang="en">structural: N-ary relation pattern: reification of a pack state at one time point. A modelling construct, not a concept.</bsdo:derivationPath>
    <rdfs:label xml:lang="en">Battery State Observation</rdfs:label>
    <rdfs:comment xml:lang="en">Reification of a pack's state at a single point in time. Temporal representation is deliberately bounded to state at an event rather than a continuous trajectory.</rdfs:comment>
  </owl:Class>
</rdf:RDF>
