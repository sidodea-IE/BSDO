<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:bsdo="https://w3id.org/bsdo#"
   xmlns:dcterms="http://purl.org/dc/terms/"
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
>
  <rdf:Description rdf:about="https://w3id.org/bsdo#Pack_V01">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bsdo#SwappableBattery"/>
    <bsdo:hasUnitIdentifier>VOLTA-PSEUDO-01</bsdo:hasUnitIdentifier>
    <bsdo:hasIdentifierScheme rdf:resource="https://w3id.org/bsdo#Scheme_Volta"/>
    <bsdo:hasEnrolmentStatus rdf:resource="https://w3id.org/bsdo#Online"/>
    <rdfs:comment xml:lang="id">Pengenal asli dipseudonimkan. Sumber: aplikasi Volta, tab Baterai. Status Menyala, energi 92%.</rdfs:comment>
    <bsdo:ownedBy rdf:resource="https://w3id.org/bsdo#Cust_V01"/>
    <bsdo:heldBy rdf:resource="https://w3id.org/bsdo#Cust_V01"/>
    <bsdo:mayBeChargedByHolder rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</bsdo:mayBeChargedByHolder>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#Dev_Volta_Cabinet">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bsdo#SwapDevice"/>
    <rdf:type rdf:resource="https://w3id.org/bsdo#ChargingDevice"/>
    <rdf:type rdf:resource="https://w3id.org/bsdo#LFPOnlyDevice"/>
    <rdfs:label xml:lang="en">Volta SGB cabinet</rdfs:label>
    <skos:altLabel xml:lang="id">kabinet SGB</skos:altLabel>
    <bsdo:acceptsChemistry rdf:resource="https://w3id.org/bsdo#LithiumIronPhosphate"/>
    <rdfs:comment xml:lang="id">Terobservasi 8 pintu dengan status dan SoC per pintu (Showroom Volta Cirebon). Melayani penukaran DAN pengisian (SCB) pada perangkat yang sama — karena itu diklasifikasikan sebagai SwapDevice sekaligus ChargingDevice. Reasoner seharusnya menginferensinya sebagai DualFunctionDevice. Kontras dengan SWAP Energy yang memisahkan kedua fungsi ke perangkat berbeda.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#Plan_SWAP_250km">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bsdo#DistanceQuotaPlan"/>
    <rdfs:label xml:lang="en">Good Good Ride</rdfs:label>
    <bsdo:quotaAmount rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">250</bsdo:quotaAmount>
    <bsdo:validityDays rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">60</bsdo:validityDays>
    <rdfs:comment xml:lang="id">Rp 45.000. Situs menyebut 45 hari, aplikasi 60 hari — versi berbeda, keduanya dicatat.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#Flow_SWAP_Swap3">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bsdo#SwapEvent"/>
    <rdfs:label xml:lang="en">SWAP direct swap, 3-slot</rdfs:label>
    <bsdo:occursAtDevice rdf:resource="https://w3id.org/bsdo#Dev_SWAP_Small"/>
    <rdfs:comment xml:lang="id">Panduan in-app 'Cara Swap Baterai', tab 3-Slot Station. Langkah 1: angkat baterai dari bagasi motor.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#Sta_Volta_Cirebon">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bsdo#SwapDevice"/>
    <rdf:type rdf:resource="https://w3id.org/bsdo#ChargingDevice"/>
    <rdfs:label xml:lang="en">Volta SGB, Cirebon showroom</rdfs:label>
    <rdfs:comment xml:lang="id">Delapan pintu; dua terisi (86%, 96%), sisanya Kosong atau Tidak Tersedia. Jam operasi 00:00-23:59 setiap hari. Tuan rumah: showroom merek.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#BatMod_SWAP_64V">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bsdo#LithiumIonSwappableBattery"/>
    <rdfs:label xml:lang="en">SWAP battery, 64 V class</rdfs:label>
    <bsdo:hasVoltageClass rdf:resource="https://w3id.org/bsdo#VC_64V"/>
    <bsdo:hasVoltageClass rdf:resource="https://w3id.org/bsdo#VC_60V"/>
    <bsdo:hasCellChemistry rdf:resource="https://w3id.org/bsdo#LithiumIon"/>
    <bsdo:hasCapacityKWh rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.3</bsdo:hasCapacityKWh>
    <bsdo:hasIdentifierScheme rdf:resource="https://w3id.org/bsdo#Scheme_SWAP"/>
    <rdfs:comment xml:lang="id">Situs resmi swap.id: Lithium-Ion, 140 x 177 x 330 mm, 1,3 kWh, IP67/CE/IEC 62133/UN 38.3. DUA kelas tegangan sengaja diasserikan: situs menyebut 64 V, aplikasi memberi label 60 V pada toggle dan lencana slot. Ketidakstabilan terminologi intra-ekosistem direkam apa adanya, tidak diselesaikan.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#Dev_SWAP_Big">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bsdo#SwapDevice"/>
    <rdf:type rdf:resource="https://w3id.org/bsdo#LithiumIonOnlyDevice"/>
    <rdfs:label xml:lang="en">SWAP Big station</rdfs:label>
    <skos:altLabel xml:lang="id">8-Slot Station</skos:altLabel>
    <bsdo:acceptsChemistry rdf:resource="https://w3id.org/bsdo#LithiumIon"/>
    <rdfs:comment xml:lang="id">Situs resmi: 11.000 W, 1800 x 790 x 644 mm, kapasitas 7 baterai. Indikator warna pada tipe ini menandakan STATE PROSES AUTENTIKASI (merah tidak terbaca, kuning sedang membaca, hijau berhasil terbaca) — berbeda arti dari tipe Small meskipun himpunan warnanya sama. Konflik homonim intra-ekosistem.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#Plan_SWAP_100km">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bsdo#DistanceQuotaPlan"/>
    <rdfs:label xml:lang="en">Try to Ride</rdfs:label>
    <bsdo:quotaAmount rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">100</bsdo:quotaAmount>
    <bsdo:validityDays rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">30</bsdo:validityDays>
    <rdfs:comment xml:lang="id">Rp 20.000. Kuota dalam KILOMETER.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#Plan_Volta_Harian">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bsdo#EventCountQuotaPlan"/>
    <rdfs:label xml:lang="id">Paket Harian</rdfs:label>
    <bsdo:quotaAmount rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1</bsdo:quotaAmount>
    <bsdo:validityDays rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</bsdo:validityDays>
    <rdfs:comment xml:lang="id">Rp 7.500. Kuota dalam JUMLAH PENUKARAN.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#Flow_Volta_SCB">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bsdo#DepositChargingEvent"/>
    <rdfs:label xml:lang="id">SCB</rdfs:label>
    <bsdo:occursAtDevice rdf:resource="https://w3id.org/bsdo#Dev_Volta_Cabinet"/>
    <bsdo:hasCustodyDeadline rdf:datatype="http://www.w3.org/2001/XMLSchema#duration">PT6H</bsdo:hasCustodyDeadline>
    <bsdo:returnsPackTo rdf:resource="https://w3id.org/bsdo#Cust_V01"/>
    <rdfs:comment xml:lang="id">Manual hlm. 6: aktifkan SCB, 15 menit untuk memindai, mulai pengisian, ambil kembali baterai miliknya sebelum 6 jam. Arah kustodi BERLAWANAN dari Tukar Titip: operator memegang pak pengguna. Keduanya seharusnya diinferensi sebagai CustodyPreservingEvent.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#Plan_SWAP_500km">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bsdo#DistanceQuotaPlan"/>
    <rdfs:label xml:lang="en">Happly Ride</rdfs:label>
    <bsdo:quotaAmount rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">500</bsdo:quotaAmount>
    <bsdo:validityDays rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">60</bsdo:validityDays>
    <rdfs:comment xml:lang="id">Rp 80.000. Ejaan 'Happly' sesuai aplikasi.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#Scheme_SWAP">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bsdo#IdentifierScheme"/>
    <rdfs:label xml:lang="en">SWAP unit identifier scheme</rdfs:label>
    <rdfs:comment xml:lang="id">Pola terobservasi: prefiks dua huruf menurut jenis entitas (BB baterai, MC kendaraan, SS stasiun) diikuti deret digit. Tidak tampak mengikuti ISO/IEC 15459.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#Sta_Volta_Mitra">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bsdo#SwapDevice"/>
    <rdfs:label xml:lang="en">Volta SGB Mitra, SPBU</rdfs:label>
    <rdfs:comment xml:lang="id">Tuan rumah SPBU. Menampilkan ketersediaan sebagai bucket agregat (50% ke bawah, 80% ke atas, booking, charging), BUKAN per pintu. Perbedaan tampilan dari Sta_Volta_Cirebon belum terjelaskan — jangan disimpulkan sebagai tipe perangkat berbeda.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n20af2267d0e94112bcd3e1a70418fff8b1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDifferent"/>
    <owl:distinctMembers rdf:nodeID="n20af2267d0e94112bcd3e1a70418fff8b2"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo/abox">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <owl:imports rdf:resource="https://w3id.org/bsdo"/>
    <dcterms:title xml:lang="en">BSDO ABox — SWAP Energy &amp; Volta</dcterms:title>
    <rdfs:comment xml:lang="id">Populasi dua ekosistem battery swap Indonesia dari observasi aplikasi, situs resmi, dan dokumentasi pabrikan. Seluruh pengenal dipseudonimkan.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#Obs_V01_a">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bsdo#BatteryStateObservation"/>
    <bsdo:observationOf rdf:resource="https://w3id.org/bsdo#Pack_V01"/>
    <bsdo:hasStateOfCharge rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">92</bsdo:hasStateOfCharge>
    <rdfs:comment xml:lang="id">Waktu pengamatan asli dipertahankan tanpa presisi lokasi. Volta memaparkan SoC per unit; TIDAK memaparkan indikator kesehatan.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#Inst_V01">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bsdo#BatteryInstallation"/>
    <bsdo:installedPack rdf:resource="https://w3id.org/bsdo#Pack_V01"/>
    <bsdo:installedIn rdf:resource="https://w3id.org/bsdo#Veh_Volta401"/>
    <rdfs:comment xml:lang="id">Pemasangan direifikasi, bukan part-of mereologis: pak berpindah antar kendaraan melalui penukaran, sehingga relasi tetap akan salah.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#BatMod_Volta_Eagle">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bsdo#LFPSwappableBattery"/>
    <rdfs:label xml:lang="en">Volta SGB battery, 64 V class</rdfs:label>
    <bsdo:hasVoltageClass rdf:resource="https://w3id.org/bsdo#VC_64V"/>
    <bsdo:hasCellChemistry rdf:resource="https://w3id.org/bsdo#LithiumIronPhosphate"/>
    <bsdo:hasCapacityAh rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">21</bsdo:hasCapacityAh>
    <bsdo:hasIdentifierScheme rdf:resource="https://w3id.org/bsdo#Scheme_Volta"/>
    <rdfs:comment xml:lang="id">Buku Panduan Pemilik Volta Eagle, hlm. 4: '64V 21 AH SGB LIFEPO4 BATTERY (2 SLOT)'. TEMUAN KUNCI: berbagi kelas tegangan 64 V dengan BatMod_SWAP_64V namun berbeda kimia sel; keduanya tetap tak dapat dipertukarkan. Konsep formal K1 {b1,b4}.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#Plan_Volta_Bulanan">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bsdo#EventCountQuotaPlan"/>
    <rdfs:label xml:lang="id">Paket Bulanan</rdfs:label>
    <bsdo:quotaAmount rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">50</bsdo:quotaAmount>
    <bsdo:validityDays rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">30</bsdo:validityDays>
    <rdfs:comment xml:lang="id">Rp 350.000. Penukaran ke-51 kembali ke harga harian. Paket terikat pada satu unit kendaraan terdaftar.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#Flow_Volta_TukarTitip">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bsdo#LoanEvent"/>
    <rdfs:label xml:lang="id">Tukar Titip</rdfs:label>
    <bsdo:occursAtDevice rdf:resource="https://w3id.org/bsdo#Dev_Volta_Cabinet"/>
    <bsdo:hasCustodyDeadline rdf:datatype="http://www.w3.org/2001/XMLSchema#duration">PT6H</bsdo:hasCustodyDeadline>
    <bsdo:returnsPackTo rdf:resource="https://w3id.org/bsdo#Cust_V01"/>
    <rdfs:comment xml:lang="id">Manual hlm. 8: bayar, 15 menit untuk memindai, ambil BATERAI PINJAMAN, tukar kembali dengan baterai miliknya sebelum 6 jam. Pengguna memegang pak operator; kepemilikan pengguna atas paknya sendiri tidak berpindah. Konsep formal K3 {f6,f7}.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#Plan_Volta_Mingguan">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bsdo#EventCountQuotaPlan"/>
    <rdfs:label xml:lang="id">Paket Mingguan</rdfs:label>
    <bsdo:quotaAmount rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">14</bsdo:quotaAmount>
    <bsdo:validityDays rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</bsdo:validityDays>
    <rdfs:comment xml:lang="id">Rp 100.000. Penukaran ke-15 kembali ke harga harian.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#Pack_S01">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bsdo#SwappableBattery"/>
    <bsdo:hasUnitIdentifier>SWAP-PSEUDO-01</bsdo:hasUnitIdentifier>
    <bsdo:hasIdentifierScheme rdf:resource="https://w3id.org/bsdo#Scheme_SWAP"/>
    <bsdo:ownedBy rdf:resource="https://w3id.org/bsdo#Op_SWAP"/>
    <rdfs:comment xml:lang="id">Pengenal asli dipseudonimkan. Sumber: tab Battery aplikasi SWAP (materi demo/promosi, penanda waktu 2021) — STRUKTUR dipakai sebagai bukti, NILAI tidak diperlakukan sebagai pengukuran. Kepemilikan operator adalah inferensi dari model tarif per-km; lihat catatan ketidakpastian di fca_insidensi_v2.md f1-f3/p7.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#Pack_V02">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bsdo#SwappableBattery"/>
    <bsdo:hasUnitIdentifier>VOLTA-PSEUDO-02</bsdo:hasUnitIdentifier>
    <bsdo:hasIdentifierScheme rdf:resource="https://w3id.org/bsdo#Scheme_Volta"/>
    <bsdo:hasEnrolmentStatus rdf:resource="https://w3id.org/bsdo#Online"/>
    <rdfs:comment xml:lang="id">Pengenal asli dipseudonimkan. Sumber: aplikasi Volta. Status Mati, energi 99%.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#Elig_SWAP">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bsdo#SwapEligibilityRule"/>
    <bsdo:thresholdPercent rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">50</bsdo:thresholdPercent>
    <bsdo:declaredBy rdf:resource="https://w3id.org/bsdo#Op_SWAP"/>
    <rdfs:label xml:lang="en">SWAP swap-eligibility threshold</rdfs:label>
    <rdfs:comment xml:lang="id">Aplikasi menyatakan 'Baterai Dapat Ditukar (SOC &gt;= 50%)'. Ambang TUNGGAL; stok dilaporkan sebagai tiga penghitung (Bisa Ditukar, Bisa Dipesan, Semua).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#Veh_Volta401">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bsdo#ElectricMotorcycle"/>
    <rdfs:label xml:lang="en">Volta 401</rdfs:label>
    <rdfs:comment xml:lang="id">Buku panduan: 1500 W, 60 km, 200 kg, 2 slot baterai. Pengenal kendaraan dipseudonimkan.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#Scheme_Volta">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bsdo#IdentifierScheme"/>
    <rdfs:label xml:lang="en">Volta unit identifier scheme</rdfs:label>
    <rdfs:comment xml:lang="id">Pola terobservasi: prefiks BT + deret digit tetap + empat huruf + deret digit. Berbeda dari skema SWAP dan tidak saling ditafsirkan. Tidak tampak mengikuti ISO/IEC 15459.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#Dev_SWAP_Small">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bsdo#SwapDevice"/>
    <rdf:type rdf:resource="https://w3id.org/bsdo#LithiumIonOnlyDevice"/>
    <rdfs:label xml:lang="en">SWAP Small station</rdfs:label>
    <skos:altLabel xml:lang="id">3-Slot Station</skos:altLabel>
    <bsdo:acceptsChemistry rdf:resource="https://w3id.org/bsdo#LithiumIon"/>
    <rdfs:comment xml:lang="id">Situs resmi: 1500 W, 839 x 305 x 411 mm, kapasitas 2 baterai, IP54/CE/IEC 62840. Aplikasi menyebutnya '3-Slot Station' — kapasitas terpublikasi (2) berbeda satu dari jumlah slot (3); slot ke-n diduga menerima pak kosong pengguna. Indikator warna pada tipe ini menandakan TINGKAT SoC (merah 0-40, biru 41-80, hijau 81-100).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#Elig_Volta_High">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bsdo#SwapEligibilityRule"/>
    <bsdo:thresholdPercent rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">80</bsdo:thresholdPercent>
    <bsdo:declaredBy rdf:resource="https://w3id.org/bsdo#Op_Volta"/>
    <rdfs:label xml:lang="en">Volta bucket, 80% and above</rdfs:label>
    <rdfs:comment xml:lang="id">Volta melaporkan DUA bucket yang tidak mempartisi interval yang sama. Pak pada 65% terklasifikasi oleh Elig_SWAP tetapi tidak masuk bucket Volta mana pun. Ketidaksepadanan ekstensi predikat — jawaban CQ5b.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#Flow_Volta_Ganti">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bsdo#SwapEvent"/>
    <rdfs:label xml:lang="id">Ganti Baterai</rdfs:label>
    <bsdo:occursAtDevice rdf:resource="https://w3id.org/bsdo#Dev_Volta_Cabinet"/>
    <rdfs:comment xml:lang="id">Manual Volta Membership hlm. 9: pilih kabinet, pindai, pintu kosong terbuka, tukar. Tidak menyebut pembayaran maupun batas waktu — kontras dengan Booking dan Tukar Titip yang menyebutnya eksplisit.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#Elig_Volta_Low">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bsdo#SwapEligibilityRule"/>
    <bsdo:thresholdPercent rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">50</bsdo:thresholdPercent>
    <bsdo:declaredBy rdf:resource="https://w3id.org/bsdo#Op_Volta"/>
    <rdfs:label xml:lang="en">Volta bucket, below 50%</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n20af2267d0e94112bcd3e1a70418fff8b2">
    <rdf:first rdf:resource="https://w3id.org/bsdo#Op_SWAP"/>
    <rdf:rest rdf:nodeID="n20af2267d0e94112bcd3e1a70418fff8b3"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#Cust_V01">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bsdo#Customer"/>
    <rdfs:label xml:lang="en">Customer V01 (pseudonymised)</rdfs:label>
    <rdfs:comment xml:lang="id">Data pribadi pihak ketiga dipseudonimkan sepenuhnya: nama, foto, nomor polisi, rangka, mesin, koordinat GPS tidak direkam.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#Obs_S01_a">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bsdo#BatteryStateObservation"/>
    <bsdo:observationOf rdf:resource="https://w3id.org/bsdo#Pack_S01"/>
    <bsdo:hasStateOfCharge rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">99</bsdo:hasStateOfCharge>
    <bsdo:hasQualitativeHealthLabel>Healthy</bsdo:hasQualitativeHealthLabel>
    <rdfs:comment xml:lang="id">SWAP memaparkan lencana kualitatif 'Healthy' tanpa skala/ambang/metode yang diungkapkan, plus suhu 30 C. Nilai berasal dari materi demo. Lencana ini TIDAK memenuhi maksud Annex XIII 4(b) Regulasi (EU) 2023/1542 dan tidak dapat dipetakan lintas operator.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#Flow_SWAP_Booking">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bsdo#SwapEvent"/>
    <rdfs:label xml:lang="en">SWAP booking</rdfs:label>
    <rdfs:comment xml:lang="id">Dialog 'Confirm Battery Booking'. Batas waktu, kewajiban pindai, dan pembukaan pintu otomatis TIDAK terdokumentasi — ditandai unarticulated di fca_insidensi_v2.md.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#Op_Volta">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bsdo#Operator"/>
    <rdfs:label xml:lang="en">Volta</rdfs:label>
    <skos:altLabel xml:lang="id">PT Volta Indonesia Semesta</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#BatMod_Volta_401">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bsdo#LFPSwappableBattery"/>
    <rdfs:label xml:lang="en">Volta SGB battery, 60 V class</rdfs:label>
    <bsdo:hasVoltageClass rdf:resource="https://w3id.org/bsdo#VC_60V"/>
    <bsdo:hasCellChemistry rdf:resource="https://w3id.org/bsdo#LithiumIronPhosphate"/>
    <bsdo:hasCapacityAh rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">23</bsdo:hasCapacityAh>
    <bsdo:hasIdentifierScheme rdf:resource="https://w3id.org/bsdo#Scheme_Volta"/>
    <rdfs:comment xml:lang="id">Buku Panduan Pemakaian dan Garansi Volta, hlm. 2: '60v 23ah SGB lifepo4 battery (2 slot)'.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#BatMod_SWAP_72V">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bsdo#LithiumIonSwappableBattery"/>
    <rdfs:label xml:lang="en">SWAP battery, 72 V class</rdfs:label>
    <bsdo:hasVoltageClass rdf:resource="https://w3id.org/bsdo#VC_72V"/>
    <bsdo:hasCellChemistry rdf:resource="https://w3id.org/bsdo#LithiumIon"/>
    <bsdo:hasCapacityAh rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">30</bsdo:hasCapacityAh>
    <bsdo:hasCapacityKWh rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2.1</bsdo:hasCapacityKWh>
    <bsdo:hasIdentifierScheme rdf:resource="https://w3id.org/bsdo#Scheme_SWAP"/>
    <rdfs:comment xml:lang="id">Situs resmi swap.id (2,1 kWh) + smoot.id (72 V / 30 Ah, 12 kg, Lithium-Ion, IP67/CE/IEC 62133/UN 38.3).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#Flow_SWAP_Swap8">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bsdo#SwapEvent"/>
    <rdfs:label xml:lang="en">SWAP direct swap, 8-slot</rdfs:label>
    <bsdo:occursAtDevice rdf:resource="https://w3id.org/bsdo#Dev_SWAP_Big"/>
    <rdfs:comment xml:lang="id">Panduan in-app, tab 8-Slot Station. Langkah 1: letakkan baterai ke pijakan baterai — pembaca terpisah sebelum slot.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#Veh_VoltaEagle">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bsdo#ElectricMotorcycle"/>
    <rdfs:label xml:lang="en">Volta Eagle</rdfs:label>
    <rdfs:comment xml:lang="id">Buku panduan: 1500 W, 60 km, 150 kg, 2 slot, double disc brake, keyless + NFC.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#Op_SWAP">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bsdo#Operator"/>
    <rdfs:label xml:lang="en">SWAP Energy</rdfs:label>
    <skos:altLabel xml:lang="id">Swap Energi Indonesia</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#Flow_Volta_Booking">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bsdo#SwapEvent"/>
    <rdfs:label xml:lang="id">Booking Baterai</rdfs:label>
    <bsdo:occursAtDevice rdf:resource="https://w3id.org/bsdo#Dev_Volta_Cabinet"/>
    <bsdo:hasParticipantCustomer rdf:resource="https://w3id.org/bsdo#Cust_V01"/>
    <rdfs:comment xml:lang="id">Manual hlm. 7: pilih kabinet, bayar, 15 menit untuk memindai, pintu terbuka.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n20af2267d0e94112bcd3e1a70418fff8b3">
    <rdf:first rdf:resource="https://w3id.org/bsdo#Op_Volta"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#Veh_DeSultan">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bsdo#ElectricMotorcycle"/>
    <rdfs:label xml:lang="en">Smoot De Sultan</rdfs:label>
    <rdfs:comment xml:lang="id">smoot.id: 72 V / 30 Ah, DC brushless 2500 W, 99 kg, beban maks 150 kg, CBS.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#Dev_SWAP_Home">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bsdo#ChargingDevice"/>
    <rdfs:label xml:lang="en">Swap Home charger</rdfs:label>
    <rdfs:comment xml:lang="id">Situs resmi: 200 W, 272 x 210 x 59 mm, 1 baterai, durasi pengisian 8 jam (0-100%). Perangkat PENGISIAN, bukan penukaran — instansi langsung pembedaan transfer energi vs transfer objek (BSOR D5).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bsdo#Sta_SWAP_Sleman">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bsdo#SwapDevice"/>
    <rdfs:label xml:lang="en">SWAP station, Sleman</rdfs:label>
    <rdfs:comment xml:lang="id">Pengenal stasiun asli berpola SS + digit, dipseudonimkan. Delapan slot terobservasi dengan SoC per slot dan label kelas tegangan per slot. Jam operasi 00:00-23:59.</rdfs:comment>
  </rdf:Description>
</rdf:RDF>
