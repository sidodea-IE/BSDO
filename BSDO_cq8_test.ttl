@prefix bsdo: <https://w3id.org/bsdo#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

#################################################################
#  UJI CQ8 — inkompatibilitas sebagai UNSATISFIABILITY
#  File TERPISAH: ontologi utama harus tetap konsisten.
#  Muat bersama BSDO_v2.ttl + BSDO_v2_abox.ttl; reasoner HARUS melaporkan
#  inkonsistensi. Jika konsisten, mekanisme CQ8 GAGAL.
#################################################################
<https://w3id.org/bsdo/cq8-test> rdf:type owl:Ontology ;
    owl:imports <https://w3id.org/bsdo/abox> ;
    rdfs:comment "Skenario uji: pak LiFePO4 Volta dimasukkan ke perangkat SWAP yang hanya menerima Li-ion."@en .

bsdo:Pack_V_test rdf:type owl:NamedIndividual , bsdo:LFPSwappableBattery ;
    bsdo:hasCellChemistry bsdo:LithiumIronPhosphate .

bsdo:Dev_SWAP_Small bsdo:accepts bsdo:Pack_V_test .
